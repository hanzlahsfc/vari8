{
  "name": "ui-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "lint": "biome check . --error-on-warnings",
    "lint:fix": "biome check . --write",
    "agent-context:check": "node scripts/agent-context.mjs --check",
    "agent-context:test": "node --test scripts/agent-context.test.mjs",
    "format": "biome format . --write",
    "test": "node scripts/test-frontend.mjs",
    "check": "npm run test && npm run agent-context:check && npm run typecheck && npm run lint && npm run ui:check && npm run build",
    "typecheck": "next typegen && tsc --noEmit",
    "ui:add": "shadcn add",
    "preview:up": "node scripts/local-preview.mjs up",
    "preview:status": "node scripts/local-preview.mjs status",
    "preview:down": "node scripts/local-preview.mjs down",
    "preview:test": "node --test scripts/local-preview.test.mjs",
    "ui:check": "node scripts/ui-system-checks.mjs --self-test && node scripts/ui-system-checks.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "lucide-react": "1.52.0",
    "motion": "14.0.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.29",
    "postcss-selector-parser": "7.1.6",
    "shadcn": "4.21.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
