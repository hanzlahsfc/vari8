  mediaObject       MediaObject        @relation(fields: [mediaObjectId], references: [id], onDelete: Restrict)
  checkInSubmission CheckInSubmission? @relation("ProgressPhotoEntrySubmission", fields: [checkInSubmissionId], references: [id], onDelete: Restrict)

