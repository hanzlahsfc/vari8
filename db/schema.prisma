// Authentication/identity + multi-tenant structure (Stage 1, slice S1-A).
// Workbook/health-domain models are intentionally NOT defined here (later slices).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  USER
  PLATFORM_ADMIN
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
  INVITED
}

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
}

enum MemberRole {
  WORKSPACE_OWNER
  COACH
  ASSISTANT_COACH
  SUPPORT
  CLIENT
}

enum MemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum AssignmentRole {
  PRIMARY
  COACH
}

enum AssignmentStatus {
  ACTIVE
  REMOVED
}

enum ClientTaskStatus {
  OPEN
  COMPLETED
  CANCELLED
}

// HABITS-I1 (decision 110): one log state per habit per day. DONE is the
// client-writable mark; SKIPPED is modelled only (writer deferred — no
// UI ships a skip control this slice). Absence of a row = not logged.
enum HabitLogStatus {
  DONE
  SKIPPED
}

// PR-SUPP: supplement-plan item status — the approved workbook planner
// choices. Coach instruction/priority only; never a taken/not-taken or
// active/paused state.
enum SupplementItemStatus {
  MUST_HAVE
  OPTIONAL
  NONE
}

enum ConsentKind {
  PRIVACY_NOTICE
  HEALTH_DATA
  CYCLE
  PHOTOS
  BLOODWORK
  PED_HRT
}

enum ConsentSource {
  CLIENT_SELF
  COACH_ATTESTED
}

enum AuditAction {
  READ
  CREATE
  UPDATE
  DELETE
  EXPORT
  GRANT
  REVOKE
  INVITE
  ASSIGN
  DENY
  LOGIN
  PASSWORD_RESET
}

enum AuditScope {
  WORKSPACE
  ACCOUNT
}

enum AuditResult {
  ALLOW
  DENY
}

enum AccessTokenPurpose {
  WORKSPACE_INVITE
  PASSWORD_RESET
}

enum NutritionImportOutcome {
  IMPORTED
  REJECTED
  DUPLICATE
}

enum ExerciseImportOutcome {
  IMPORTED
  REJECTED
  DUPLICATE
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  // PR-05: legacy mirror column — Better Auth writes credential hashes to
  // `accounts.password`; kept with a default so Better Auth's user insert
  // doesn't trip on a required column it doesn't know.
  // PR-R2 removal marker: `users.password_hash` is read-dead and is dropped
  // by the PR-R2 migration; do not add new readers/writers.
  passwordHash   String       @default("") @map("password_hash")
  name           String?
  platformRole   PlatformRole @default(USER) @map("platform_role")
  status         UserStatus   @default(ACTIVE)
  // S1-F1: bumped at password-reset consumption so already-issued JWT sessions
  // become stale (founder decision: reset logs out other devices). Not yet
  // embedded in or compared by JWT validation — no auth behavior change yet.
  // PR-R2 removal marker: `users.session_version` is read-dead under Better
  // Auth (session rows are the authority) and is dropped by the PR-R2
  // migration; do not add new readers/writers.
  sessionVersion Int          @default(0) @map("session_version")
  // PR-05 (Better Auth): credential identity now lives on `account` rows; this
  // flag records whether the address was verified (invite acceptance counts).
  emailVerified  Boolean      @default(false) @map("email_verified")
  image          String?
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  // PR-05 (Better Auth): database sessions + credential/OAuth account records.
  sessions Session[]
  accounts Account[]

  memberships                    WorkspaceMember[]
  clientProfiles                 ClientProfile[]
  consentsGranted                ConsentRecord[]
  auditEvents                    AuditEvent[]
  // S1-F2B: account-scoped audit rows (e.g. reset activity) owned by this user.
  subjectAuditedEvents           AuditEvent[]           @relation("AuditSubjectUser")
  accessTokens                   AccessToken[]          @relation("AccessTokenUser")
  issuedAccessTokens             AccessToken[]          @relation("AccessTokenCreator")
  // P-023: durable submission provenance (the submitting client user).
  onboardingSubmissionsSubmitted OnboardingSubmission[] @relation("OnboardingSubmissionSubmittedByUser")
  checkInSubmissionsSubmitted    CheckInSubmission[]    @relation("CheckInSubmissionSubmittedByUser")

  completedClientTasks ClientTask[] @relation("ClientTaskCompleter")

  // HABITS-I1: best-effort provenance pointer for habit logs (SetNull —
  // mirrors ConsentRecord.grantedBy / ClientTask.completedBy).
  habitLogs HabitLog[] @relation("HabitLogLogger")

  // PR-M0: media uploader provenance (SetNull), message sender (SetNull),
  // message drafts (Cascade) and read markers (Cascade).
  mediaObjectsUploaded MediaObject[]  @relation("MediaObjectUploader")
  messagesSent         Message[]      @relation("MessageSender")
  messageDrafts        MessageDraft[] @relation("MessageDraftAuthor")
  messageReads         MessageRead[]

  @@map("users")
}

// PR-05 (Better Auth): session rows ARE the session — revocation is row
// deletion, so no per-request version compare is needed anymore.
model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  // AUTH-ROTATE: rotation family. NULL for a session created by sign-in (it
  // starts a new family, whose id is that session's own id); every session
  // minted by POST /api/v1/auth/refresh carries the family of the token it
  // replaced. Replaying a spent token deletes the whole family.
  familyId  String?  @map("family_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

// AUTH-ROTATE: tombstones for bearer tokens that have been rotated out, keyed
// on the SHA-256 digest (a raw token is never stored here or anywhere else).
// A refresh request presenting a tombstoned token is a replay: the whole
// family's sessions are deleted. `expiresAt` is the spent session's own
// expiry, so a row is dead evidence once the token it names could no longer
// resolve anyway.
model SpentRefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique @map("token_hash")
  familyId  String   @map("family_id")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([familyId])
  @@map("spent_refresh_tokens")
}

// PR-05 (Better Auth): credential accounts carry the scrypt password hash;
// providerId "credential" + accountId = user id (Better Auth convention).
model Account {
  id                    String    @id @default(cuid())
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  idToken               String?   @map("id_token")
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

// PR-05 (Better Auth): reset/verification tokens. Password-reset rows use
// identifier "reset-password:<token>", value = user id, and are consumed
// atomically (single use) inside the password write transaction.
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([identifier])
  @@map("verifications")
}

// PR-05 (Better Auth): DB-backed rate-limit buckets (storage="database").
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("rate_limit")
}

model Workspace {
  id                           String            @id @default(cuid())
  name                         String
  slug                         String            @unique
  status                       WorkspaceStatus   @default(ACTIVE)
  // PR-M0: retention + appearance + studio dashboard (D31) workspace
  // settings. CHECKs live in the migration's raw SQL.
  retentionDays                Int               @default(90) @map("retention_days")
  appearanceMode               AppearanceMode    @default(DARK) @map("appearance_mode")
  appearanceAccent             String            @default("#EB91B8") @map("appearance_accent") @db.VarChar(7)
  appearanceFont               AppearanceFont    @default(SANS) @map("appearance_font")
  appearanceDensity            AppearanceDensity @default(COMFORTABLE) @map("appearance_density")
  logoMediaId                  String?           @map("logo_media_id")
  availabilityText             String            @default("") @map("availability_text")
  notificationsEnabled         Boolean           @default(true) @map("notifications_enabled")
  priorityNotificationsEnabled Boolean           @default(true) @map("priority_notifications_enabled")
  studioDashboardDraft         Json?             @map("studio_dashboard_draft")
  studioDashboardDraftRevision Int               @default(1) @map("studio_dashboard_draft_revision")
  createdAt                    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  logoMedia                     MediaObject?                       @relation("WorkspaceLogo", fields: [logoMediaId], references: [id], onDelete: Restrict)
  members                       WorkspaceMember[]
  clientProfiles                ClientProfile[]
  auditEvents                   AuditEvent[]
  accessTokens                  AccessToken[]
  onboardingForms               OnboardingForm[]
  onboardingFormAssignments     OnboardingFormAssignment[]
  parameterDefinitions          ParameterDefinition[]
  coachingTemplates             CoachingTemplate[]
  coachingTemplateVersions      CoachingTemplateVersion[]
  coachingTemplateVersionParams CoachingTemplateVersionParameter[]
  clientSetups                  ClientSetup[]
  clientSetupPins               ClientSetupPin[]
  dailyEntries                  DailyEntry[]
  nutritionLogs                 NutritionLog[]
  onboardingSubmissions         OnboardingSubmission[]
  onboardingSubmissionAnswers   OnboardingSubmissionAnswer[]
  checkInForms                  CheckInForm[]
  checkInFormVersions           CheckInFormVersion[]
  checkInInstances              CheckInInstance[]
  checkInSubmissions            CheckInSubmission[]
  checkInSubmissionAnswers      CheckInSubmissionAnswer[]
  checkInReviews                CheckInReview[]
  checkInFeedback               CheckInFeedback[]
  checkInScheduleRules          CheckInScheduleRule[]
  onboardingSubmissionReviews   OnboardingSubmissionReview[]
  clientDashboardLayouts        ClientDashboardLayout[]
  clientTasks                   ClientTask[]
  habits                        Habit[]
  mealPlans                     MealPlan[]
  mealPlanVersions              MealPlanVersion[]
  trainingPrograms              TrainingProgram[]
  trainingProgramVersions       TrainingProgramVersion[]
  trainingSessionBookings       TrainingSessionBooking[]
  trainingSessionLogs           TrainingSessionLog[]
  trainingSetLogs               TrainingSetLog[]
  supplementPlans               SupplementPlan[]
  supplementPlanItems           SupplementPlanItem[]

  // PR-M0 (schema v2) tenant tables.
  mediaObjects            MediaObject[]
  coachNotes              CoachNote[]
  coachTasks              CoachTask[]
  clientPhases            ClientPhase[]
  clientWeekNotes         ClientWeekNote[]
  trackerComments         TrackerComment[]
  clientGoals             ClientGoal[]
  savedMeals              SavedMeal[]
  exerciseLibraryItems    ExerciseLibraryItem[]
  clientPlans             ClientPlan[]
  iifymPlans              IifymPlan[]
  iifymPlanVersions       IifymPlanVersion[]
  conversations           Conversation[]
  messages                Message[]
  messageDrafts           MessageDraft[]
  messageAttachments      MessageAttachment[]
  messageDraftAttachments MessageDraftAttachment[]
  checkinAnswerMedia      CheckInAnswerMedia[]
  activityTargets         ActivityTarget[]
  progressPhotoEntries    ProgressPhotoEntry[]

  @@map("workspace")
}

model WorkspaceMember {
  id               String       @id @default(cuid())
  workspaceId      String       @map("workspace_id")
  userId           String       @map("user_id")
  role             MemberRole
  status           MemberStatus @default(INVITED)
  // S1-F2C repair: DB-owned membership-state generation. The raw trigger
  // (migration 20260930190000) sets it to 0 on insert and increments it iff
  // status/role change — callers must never write it directly.
  stateVersion     Int          @default(0) @map("state_version")
  // PR-M0: per-member UI preference.
  sidebarCollapsed Boolean      @default(false) @map("sidebar_collapsed")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  coachProfile CoachProfile?
  assignments  ClientAssignment[] @relation("ClientAssignmentCoach")

  onboardingFormsCreated       OnboardingForm[]           @relation("OnboardingFormCreator")
  onboardingFormsArchived      OnboardingForm[]           @relation("OnboardingFormArchiver")
  onboardingFormVersions       OnboardingFormVersion[]    @relation("OnboardingFormVersionPublisher")
  onboardingAssignmentsCreated OnboardingFormAssignment[] @relation("OnboardingAssignmentAssignedBy")
  onboardingAssignmentsEnded   OnboardingFormAssignment[] @relation("OnboardingAssignmentEndedBy")
  clientSetupPinsAssigned      ClientSetupPin[]           @relation("ClientSetupPinAssignedBy")
  clientSetupPinsEnded         ClientSetupPin[]           @relation("ClientSetupPinEndedBy")

  dailyEntriesCreated            DailyEntry[]           @relation("DailyEntryCreator")
  dailyEntryRevisionsCreated     DailyEntryRevision[]   @relation("DailyEntryRevisionCreator")
  nutritionLogsCreated           NutritionLog[]         @relation("NutritionLogCreator")
  nutritionLogsUpdated           NutritionLog[]         @relation("NutritionLogUpdater")
  onboardingSubmissionsSubmitted OnboardingSubmission[] @relation("OnboardingSubmissionSubmittedByMember")

  checkInFormsCreated                 CheckInForm[]                @relation("CheckInFormCreator")
  checkInFormsArchived                CheckInForm[]                @relation("CheckInFormArchiver")
  checkInFormVersions                 CheckInFormVersion[]         @relation("CheckInFormVersionPublisher")
  checkInInstancesScheduled           CheckInInstance[]            @relation("CheckInInstanceScheduler")
  checkInInstancesCancelled           CheckInInstance[]            @relation("CheckInInstanceCanceller")
  checkInSubmissions                  CheckInSubmission[]          @relation("CheckInSubmissionSubmittedByMember")
  checkInReviews                      CheckInReview[]              @relation("CheckInReviewReviewer")
  checkInFeedbackAuthored             CheckInFeedback[]            @relation("CheckInFeedbackAuthor")
  checkInScheduleRulesCreated         CheckInScheduleRule[]        @relation("CheckInScheduleRuleCreator")
  checkInScheduleRulesPaused          CheckInScheduleRule[]        @relation("CheckInScheduleRulePauser")
  checkInScheduleRulesEnded           CheckInScheduleRule[]        @relation("CheckInScheduleRuleEnder")
  onboardingSubmissionReviewsReviewed OnboardingSubmissionReview[] @relation("OnboardingReviewReviewer")
  dashboardLayoutsEdited              ClientDashboardLayout[]      @relation("DashboardLayoutEditor")
  assignedClientTasks                 ClientTask[]                 @relation("ClientTaskAssigner")
  cancelledClientTasks                ClientTask[]                 @relation("ClientTaskCanceller")

  parametersCreated         ParameterDefinition[]     @relation("ParameterDefinitionCreator")
  parametersUpdated         ParameterDefinition[]     @relation("ParameterDefinitionUpdater")
  parametersArchived        ParameterDefinition[]     @relation("ParameterDefinitionArchiver")
  coachingTemplatesCreated  CoachingTemplate[]        @relation("CoachingTemplateCreator")
  coachingTemplatesArchived CoachingTemplate[]        @relation("CoachingTemplateArchiver")
  coachingTemplateVersions  CoachingTemplateVersion[] @relation("CoachingTemplateVersionPublisher")

  mealPlansCreated          MealPlan[]        @relation("MealPlanCreator")
  mealPlanDraftsSaved       MealPlan[]        @relation("MealPlanDraftSaver")
  mealPlanTimezonesSet      MealPlan[]        @relation("MealPlanTimezoneSetter")
  mealPlanVersionsPublished MealPlanVersion[] @relation("MealPlanVersionPublisher")

  supplementPlansCreated SupplementPlan[] @relation("SupplementPlanCreator")
  supplementPlansSaved   SupplementPlan[] @relation("SupplementPlanSaver")

  trainingProgramsCreated          TrainingProgram[]        @relation("TrainingProgramCreator")
  trainingProgramsDraftsSaved      TrainingProgram[]        @relation("TrainingProgramDraftSaver")
  trainingProgramsTimezonesSet     TrainingProgram[]        @relation("TrainingProgramTimezoneSetter")
  trainingProgramsCancelled        TrainingProgram[]        @relation("TrainingProgramCanceller")
  trainingProgramVersionsPublished TrainingProgramVersion[] @relation("TrainingProgramVersionPublisher")
  trainingBookingsScheduled        TrainingSessionBooking[] @relation("TrainingBookingScheduler")
  trainingBookingsCancelled        TrainingSessionBooking[] @relation("TrainingBookingCanceller")

  // PR-M0 (schema v2) member provenance relations.
  coachNotesAuthored          CoachNote[]           @relation("CoachNoteAuthor")
  clientWeekNotesAuthored     ClientWeekNote[]      @relation("ClientWeekNoteAuthor")
  coachTasksCreated           CoachTask[]           @relation("CoachTaskCreator")
  coachTasksCompleted         CoachTask[]           @relation("CoachTaskCompleter")
  trackerCommentsAuthored     TrackerComment[]      @relation("TrackerCommentAuthor")
  clientGoalsCreated          ClientGoal[]          @relation("ClientGoalCreator")
  activityTargetsCreated      ActivityTarget[]      @relation("ActivityTargetCreator")
  savedMealsCreated           SavedMeal[]           @relation("SavedMealCreator")
  exerciseLibraryItemsCreated ExerciseLibraryItem[] @relation("ExerciseLibraryItemCreator")
  clientPlansUpdated          ClientPlan[]          @relation("ClientPlanUpdater")
  iifymPlansCreated           IifymPlan[]           @relation("IifymPlanCreator")
  iifymPlanDraftsSaved        IifymPlan[]           @relation("IifymPlanDraftSaver")
  iifymPlanTimezonesSet       IifymPlan[]           @relation("IifymPlanTimezoneSetter")
  iifymPlanVersionsPublished  IifymPlanVersion[]    @relation("IifymPlanVersionPublisher")

  @@unique([workspaceId, userId])
  // Composite target for the ClientAssignment same-workspace foreign key (raw SQL).
  @@unique([id, workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, role])
  @@index([userId])
  @@map("workspace_member")
}

model CoachProfile {
  id                String   @id @default(cuid())
  workspaceMemberId String   @unique @map("workspace_member_id")
  displayName       String   @map("display_name")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspaceMember WorkspaceMember @relation(fields: [workspaceMemberId], references: [id], onDelete: Cascade)

  @@map("coach_profile")
}

model ClientProfile {
  id                      String    @id @default(cuid())
  workspaceId             String    @map("workspace_id")
  userId                  String?   @map("user_id")
  name                    String
  // PR-M0: canvas roster metadata + archive provenance (D20 priority flag).
  // The archive pairing CHECK is raw migration SQL. No phase/week columns
  // (D27: derived from the assigned plan).
  label                   String?   @map("label")
  coachingSince           DateTime? @map("coaching_since") @db.Date
  heightCm                Decimal?  @map("height_cm") @db.Decimal(5, 1)
  archivedAt              DateTime? @map("archived_at") @db.Timestamptz(6)
  archiveReason           String?   @map("archive_reason")
  priorityMessagesAllowed Boolean   @default(false) @map("priority_messages_allowed")
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  assignments                 ClientAssignment[]           @relation("ClientAssignmentClient")
  consents                    ConsentRecord[]
  auditSubjectEvents          AuditEvent[]
  onboardingAssignments       OnboardingFormAssignment[]   @relation("OnboardingAssignmentClient")
  clientSetups                ClientSetup[]                @relation("ClientSetupClient")
  clientSetupPins             ClientSetupPin[]             @relation("ClientSetupPinClient")
  dailyEntries                DailyEntry[]                 @relation("ClientProfileDailyEntries")
  nutritionLogs               NutritionLog[]               @relation("ClientProfileNutritionLogs")
  onboardingSubmissions       OnboardingSubmission[]       @relation("OnboardingSubmissionClient")
  checkInInstances            CheckInInstance[]            @relation("CheckInInstanceClient")
  checkInSubmissions          CheckInSubmission[]          @relation("CheckInSubmissionClient")
  progressPhotos              ProgressPhotoEntry[]         @relation("ProgressPhotoEntryClient")
  checkInReviews              CheckInReview[]              @relation("CheckInReviewClient")
  checkInFeedback             CheckInFeedback[]            @relation("CheckInFeedbackClient")
  checkInScheduleRules        CheckInScheduleRule[]        @relation("CheckInScheduleRuleClient")
  checkInAnswers              CheckInSubmissionAnswer[]    @relation("CheckInAnswerClient")
  onboardingSubmissionReviews OnboardingSubmissionReview[] @relation("OnboardingReviewClient")
  dashboardLayouts            ClientDashboardLayout[]      @relation("ClientDashboardLayoutClient")
  clientTasks                 ClientTask[]                 @relation("ClientTaskClient")
  habits                      Habit[]                      @relation("HabitClient")
  mealPlan                    MealPlan?                    @relation("MealPlanClient")
  mealPlanVersions            MealPlanVersion[]            @relation("MealPlanVersionClient")
  supplementPlan              SupplementPlan?              @relation("SupplementPlanClient")
  supplementPlanItems         SupplementPlanItem[]         @relation("SupplementPlanItemClient")
  trainingPrograms            TrainingProgram[]            @relation("TrainingProgramClient")
  trainingProgramVersions     TrainingProgramVersion[]     @relation("TrainingProgramVersionClient")
  trainingBookings            TrainingSessionBooking[]     @relation("TrainingBookingClient")
  trainingSessionLogs         TrainingSessionLog[]         @relation("TrainingSessionLogClient")
  trainingSetLogs             TrainingSetLog[]             @relation("TrainingSetLogClient")

  // PR-M0 (schema v2) client-scoped records.
  coachNotes        CoachNote[]        @relation("CoachNoteClient")
  coachTasks        CoachTask[]        @relation("CoachTaskClient")
  clientPhases      ClientPhase[]      @relation("ClientPhaseClient")
  clientWeekNotes   ClientWeekNote[]   @relation("ClientWeekNoteClient")
  trackerComments   TrackerComment[]   @relation("TrackerCommentClient")
  clientGoals       ClientGoal[]       @relation("ClientGoalClient")
  activityTargets   ActivityTarget[]   @relation("ActivityTargetClient")
  clientPlan        ClientPlan?        @relation("ClientPlanClient")
  iifymPlan         IifymPlan?         @relation("IifymPlanClient")
  iifymPlanVersions IifymPlanVersion[] @relation("IifymPlanVersionClient")
  conversations     Conversation[]     @relation("ConversationClient")

  // Workspace-scoped uniqueness: the same identity may be a client in different workspaces.
  @@unique([workspaceId, userId])
  // Composite target for the ClientAssignment same-workspace foreign key (raw SQL).
  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@index([workspaceId, archivedAt])
  @@map("client_profile")
}

model ClientAssignment {
  id              String           @id @default(cuid())
  workspaceId     String           @map("workspace_id")
  clientProfileId String           @map("client_profile_id")
  coachMemberId   String           @map("coach_member_id")
  role            AssignmentRole
  status          AssignmentStatus @default(ACTIVE)
  assignedAt      DateTime         @default(now()) @map("assigned_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  clientProfile ClientProfile   @relation("ClientAssignmentClient", fields: [clientProfileId], references: [id], onDelete: Restrict)
  coachMember   WorkspaceMember @relation("ClientAssignmentCoach", fields: [coachMemberId], references: [id], onDelete: Restrict)

  // Same-workspace invariant is enforced at the database level by composite foreign keys
  // added in the migration's raw SQL (Prisma cannot express two relations sharing workspace_id).
  @@unique([clientProfileId, coachMemberId])
  @@index([workspaceId])
  @@index([coachMemberId, status])
  @@index([clientProfileId, status])
  @@map("client_assignment")
}

model ConsentRecord {
  id              String        @id @default(cuid())
  clientProfileId String        @map("client_profile_id")
  kind            ConsentKind
  version         String
  grantedAt       DateTime      @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt       DateTime?     @map("revoked_at") @db.Timestamptz(6)
  grantedByUserId String?       @map("granted_by_user_id")
  source          ConsentSource @default(CLIENT_SELF)

  clientProfile ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Restrict)
  grantedBy     User?         @relation(fields: [grantedByUserId], references: [id], onDelete: SetNull)

  // Exact-version active-consent lookup. The "at most one unrevoked row per
  // (client, kind, version)" invariant is a raw partial unique index in the migration
  // (Prisma cannot express partial indexes).
  @@index([clientProfileId, kind, version, revokedAt])
  @@map("consent_record")
}

model AuditEvent {
  id                     String      @id @default(cuid())
  // S1-F2B: scope discriminates tenant-owned rows from account-owned security
  // rows. Ownership shapes are enforced by raw SQL CHECKs in the migration
  // (WORKSPACE scope ⇒ workspace_id set + subject_user_id null; ACCOUNT scope
  // ⇒ subject_user_id set + workspace_id null) — Prisma cannot express it.
  scope                  AuditScope  @default(WORKSPACE)
  workspaceId            String?     @map("workspace_id")
  actorUserId            String?     @map("actor_user_id")
  actorRole              MemberRole? @map("actor_role")
  action                 AuditAction
  resourceType           String      @map("resource_type")
  resourceId             String?     @map("resource_id")
  subjectClientProfileId String?     @map("subject_client_profile_id")
  subjectUserId          String?     @map("subject_user_id")
  result                 AuditResult
  reason                 String?
  at                     DateTime    @default(now()) @db.Timestamptz(6)
  ip                     String?
  meta                   Json?

  workspace            Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  actor                User?          @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  subjectClientProfile ClientProfile? @relation(fields: [subjectClientProfileId], references: [id], onDelete: SetNull)
  subjectUser          User?          @relation("AuditSubjectUser", fields: [subjectUserId], references: [id], onDelete: Restrict)

  // Read paths: tenant-scoped, time-ordered listing ([workspaceId, at]) and
  // tenant-scoped id-cursor pagination used by listAuditEvents ([workspaceId, id]).
  // Account path: internal subject listing supports BOTH time order
  // ([subjectUserId, at]) and the id-cursor pagination used by
  // listAccountAuditEvents ([subjectUserId, id]).
  @@index([workspaceId, at])
  @@index([workspaceId, id])
  @@index([subjectUserId, at])
  @@index([subjectUserId, id], map: "audit_event_subject_user_id_id_idx")
  @@map("audit_event")
}

// S1-F1: purpose-scoped, hash-only access tokens (invitations / password reset).
// Ephemeral security records — not audit rows. Purpose-dependent nullability is
// enforced by named CHECK constraints in the migration (Prisma cannot express
// it): invites require workspace/email/role/issuer and may carry user_id only
// once consumed; resets require user_id and forbid every invite field.
// Raw bearer tokens are NEVER stored — only the SHA-256 hex digest
// (lib/tokens/crypto.ts) may land in token_hash.
model AccessToken {
  id                       String             @id @default(cuid())
  purpose                  AccessTokenPurpose
  tokenHash                String             @unique @map("token_hash")
  workspaceId              String?            @map("workspace_id")
  userId                   String?            @map("user_id")
  // Normalized plaintext invite address — personal data, deliberately not
  // standalone-indexed; no approved HMAC secret exists and an unsalted hash
  // would be enumerable.
  targetEmail              String?            @map("target_email")
  intendedRole             MemberRole?        @map("intended_role")
  createdByUserId          String?            @map("created_by_user_id")
  // S1-F2C repair: generation of the target (workspace,email→user) membership
  // at issuance — NULL = no member existed. Acceptance requires equality with
  // the member's current state_version (causal freshness, clock-independent).
  targetMemberStateVersion Int?               @map("target_member_state_version")
  expiresAt                DateTime           @map("expires_at") @db.Timestamptz(6)
  consumedAt               DateTime?          @map("consumed_at") @db.Timestamptz(6)
  revokedAt                DateTime?          @map("revoked_at") @db.Timestamptz(6)
  createdAt                DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  // workspaceId: Restrict — tenant boundary; a workspace cannot disappear with
  // outstanding invite rows. userId: Cascade — user-owned reset rows are
  // meaningless without the user (SetNull would violate reset_shape).
  // createdByUserId: Restrict — issuer deletion must not silently sever issued
  // invites; erasure flows must revoke/delete them first.
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user      User?      @relation("AccessTokenUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User?      @relation("AccessTokenCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  // (workspace_id, purpose, target_email, intended_role) supports the future
  // replacement-invalidates-matching lookup without indexing the email alone.
  @@index([workspaceId, purpose, targetEmail, intendedRole], map: "access_token_invite_target_idx")
  @@index([userId, purpose], map: "access_token_user_id_purpose_idx")
  @@index([expiresAt], map: "access_token_expires_at_idx")
  // Owner-only invitation listing: WHERE workspace+purpose ORDER BY id.
  @@index([workspaceId, purpose, id], map: "access_token_ws_invite_list_idx")
  // Expression index (raw SQL only — Prisma cannot model it):
  // "access_token_terminal_cleanup_idx" on (effective-terminal-ts, id) backs
  // cleanupTerminalAccessTokens; see migration 20260930180000.
  // Member-state-generation column/trigger/CHECK are raw SQL; see migration
  // 20260930190000.
  @@map("access_token")
}

// ---------------------------------------------------------------------------
// Phase 2.1 — Nutrition Database catalog (imported reference master data)
// ---------------------------------------------------------------------------
// One row per accepted source row of the PRGRSS "Nutrition Database" export.
// Values are mapped verbatim from source headers (see
// docs/tasks/phase-2-1-nutrition-catalog.md); empty source cells stay NULL and
// are never replaced with 0. Deliberately NOT Mealplan and NOT a calculator:
// nothing here is derived.
model NutritionCatalogItem {
  id              String   @id @default(cuid())
  // Source `NO.` column — the source's own row identifier (unique in the export).
  sourceNo        Int      @unique @map("source_no")
  // SHA-256 of the canonical mapped fields; lets re-imports detect real changes.
  rowFingerprint  String   @map("row_fingerprint")
  name            String
  amount          Float?
  unit            String?
  calories        Float?
  protein         Float?
  carbs           Float?
  fats            Float?
  state           String?
  category        String?
  firstImportedAt DateTime @default(now()) @map("first_imported_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Category filter (exact). The name substring-search index is a pg_trgm GIN
  // index created in raw SQL (Prisma cannot express GIN) — see migration
  // 20261001100000; keep `migrate deploy` (never let `migrate dev` drop it).
  @@index([category])
  @@map("nutrition_catalog_item")
}

// Provenance for one import execution. No source file content is stored — only
// a content fingerprint and counts, so an import is auditable without retaining
// the private source export.
model NutritionImportRun {
  id                   String   @id @default(cuid())
  sourceName           String   @map("source_name")
