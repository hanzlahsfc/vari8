}

// V3-L1-IIFYM: mirrors meal_plan / meal_plan_version column for column —
// same uniques, indexes, pairing CHECKs and raw coherence FKs, renamed.
// Payload { options: IifymOption[], schedule: VariantSchedule } is typed
// in lib/db-types.
model IifymPlan {
  id                    String    @id @default(cuid())
  workspaceId           String    @map("workspace_id")
  clientProfileId       String    @unique @map("client_profile_id")
  title                 String
  timezone              String?
  timezoneSetByMemberId String?   @map("timezone_set_by_member_id")
  timezoneSetAt         DateTime? @map("timezone_set_at") @db.Timestamptz(6)
  draft                 Json?
  draftRevision         Int       @default(1) @map("draft_revision")
  draftSavedByMemberId  String?   @map("draft_saved_by_member_id")
  draftUpdatedAt        DateTime? @map("draft_updated_at") @db.Timestamptz(6)
  createdByMemberId     String    @map("created_by_member_id")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace           Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  clientProfile       ClientProfile      @relation("IifymPlanClient", fields: [clientProfileId], references: [id], onDelete: Restrict)
  createdByMember     WorkspaceMember    @relation("IifymPlanCreator", fields: [createdByMemberId], references: [id], onDelete: Restrict)
  draftSavedByMember  WorkspaceMember?   @relation("IifymPlanDraftSaver", fields: [draftSavedByMemberId], references: [id], onDelete: Restrict)
  timezoneSetByMember WorkspaceMember?   @relation("IifymPlanTimezoneSetter", fields: [timezoneSetByMemberId], references: [id], onDelete: Restrict)
  versions            IifymPlanVersion[]

  @@unique([id, workspaceId])
  @@unique([id, workspaceId, clientProfileId])
  @@index([workspaceId])
  @@map("iifym_plan")
}

model IifymPlanVersion {
  id                    String   @id @default(cuid())
  // Denormalized tenant + client stamps — immutable at publish; part of
  // the (id, workspaceId, iifymPlanId) coherence target.
  workspaceId           String   @map("workspace_id")
  iifymPlanId           String   @map("iifym_plan_id")
  clientProfileId       String   @map("client_profile_id")
  versionSeq            Int      @map("version_seq")
  // Declared calendar date + the IANA zone + resolved local-midnight
  // instant — all immutable snapshots taken at publish.
  effectiveDate         DateTime @map("effective_date") @db.Date
  effectiveTimezone     String   @map("effective_timezone")
  activationInstant     DateTime @map("activation_instant") @db.Timestamptz(6)
  payload               Json
  publishOriginRevision Int      @map("publish_origin_revision")
  publishedAt           DateTime @default(now()) @map("published_at") @db.Timestamptz(6)
  publishedByMemberId   String   @map("published_by_member_id")

  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  iifymPlan         IifymPlan       @relation(fields: [iifymPlanId], references: [id], onDelete: Restrict)
  clientProfile     ClientProfile   @relation("IifymPlanVersionClient", fields: [clientProfileId], references: [id], onDelete: Restrict)
  publishedByMember WorkspaceMember @relation("IifymPlanVersionPublisher", fields: [publishedByMemberId], references: [id], onDelete: Restrict)

  @@unique([iifymPlanId, versionSeq])
  // Deterministic publish-replay authority (matches the raw index name).
  @@unique([iifymPlanId, publishOriginRevision], map: "iifym_plan_version_publish_origin_key")
  @@unique([id, workspaceId, iifymPlanId])
  @@index([iifymPlanId, effectiveDate, versionSeq])
  @@index([iifymPlanId, activationInstant])
  @@map("iifym_plan_version")
}

// ── D20 messaging: one thread per client, idempotent sends, drafts and
// read markers.

model Conversation {
  id              String    @id @default(cuid())
  workspaceId     String    @map("workspace_id")
  clientProfileId String    @map("client_profile_id")
  lastMessageAt   DateTime? @map("last_message_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  clientProfile ClientProfile  @relation("ConversationClient", fields: [clientProfileId], references: [id], onDelete: Restrict)
  messages      Message[]
  drafts        MessageDraft[]

  // One thread per client.
  @@unique([workspaceId, clientProfileId])
  @@unique([id, workspaceId])
  @@index([workspaceId, lastMessageAt])
  @@map("conversation")
}

model Message {
  id              String            @id @default(cuid())
  workspaceId     String            @map("workspace_id")
  conversationId  String            @map("conversation_id")
  senderKind      MessageSenderKind @map("sender_kind")
  senderUserId    String?           @map("sender_user_id")
  body            String            @default("")
  priority        Boolean           @default(false)
  links           Json?
  clientRequestId String            @map("client_request_id")
  sentAt          DateTime          @default(now()) @map("sent_at") @db.Timestamptz(6)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  sender       User?               @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)
  attachments  MessageAttachment[]
  reads        MessageRead[]

  // Send idempotency: one durable row per client-generated request id.
  @@unique([conversationId, clientRequestId])
  @@unique([id, workspaceId])
  @@index([conversationId, sentAt, id])
  @@map("message")
}

model MessageAttachment {
  messageId     String @map("message_id")
  mediaObjectId String @map("media_object_id")
  workspaceId   String @map("workspace_id")
  position      Int    @default(0)

  message     Message     @relation(fields: [messageId], references: [id], onDelete: Restrict)
  mediaObject MediaObject @relation(fields: [mediaObjectId], references: [id], onDelete: Restrict)
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@id([messageId, mediaObjectId])
  @@map("message_attachment")
}

model MessageDraft {
  id             String   @id @default(cuid())
  workspaceId    String   @map("workspace_id")
  conversationId String   @map("conversation_id")
  authorUserId   String   @map("author_user_id")
  body           String   @default("")
  links          Json?
  revision       Int      @default(1)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace    Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  conversation Conversation             @relation(fields: [conversationId], references: [id], onDelete: Restrict)
  author       User                     @relation("MessageDraftAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)
  attachments  MessageDraftAttachment[]

  // One draft per author per conversation.
  @@unique([conversationId, authorUserId])
  @@unique([id, workspaceId])
  @@map("message_draft")
}

model MessageDraftAttachment {
  draftId       String @map("draft_id")
  mediaObjectId String @map("media_object_id")
  workspaceId   String @map("workspace_id")
  position      Int    @default(0)

  draft       MessageDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  mediaObject MediaObject  @relation(fields: [mediaObjectId], references: [id], onDelete: Restrict)
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@id([draftId, mediaObjectId])
  @@map("message_draft_attachment")
}

model MessageRead {
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  readAt    DateTime @map("read_at") @db.Timestamptz(6)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId])
  @@map("message_read")
}

// VISUAL check-in answers: media attachments join table.
model CheckInAnswerMedia {
  answerId      String @map("answer_id")
  mediaObjectId String @map("media_object_id")
  workspaceId   String @map("workspace_id")
  position      Int    @default(0)

  answer      CheckInSubmissionAnswer @relation(fields: [answerId], references: [id], onDelete: Restrict)
  mediaObject MediaObject             @relation(fields: [mediaObjectId], references: [id], onDelete: Restrict)
  workspace   Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@id([answerId, mediaObjectId])
  @@map("checkin_answer_media")
}

// PR-SUPP: one saved supplement plan per client — latest-saved
// whole-plan semantics (the approved UI ships no draft/active/history
// lifecycle). revision is the save-CAS guard; saved_* provenance marks
// the last committed save. Composite coherence keys feed the raw
// migration FKs.
model SupplementPlan {
  id                String    @id @default(cuid())
  workspaceId       String    @map("workspace_id")
  clientProfileId   String    @unique @map("client_profile_id")
  name              String
  revision          Int       @default(1)
  savedByMemberId   String?   @map("saved_by_member_id")
  savedAt           DateTime? @map("saved_at") @db.Timestamptz(6)
  createdByMemberId String    @map("created_by_member_id")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace       Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  clientProfile   ClientProfile        @relation("SupplementPlanClient", fields: [clientProfileId], references: [id], onDelete: Restrict)
  savedByMember   WorkspaceMember?     @relation("SupplementPlanSaver", fields: [savedByMemberId], references: [id], onDelete: Restrict)
  createdByMember WorkspaceMember      @relation("SupplementPlanCreator", fields: [createdByMemberId], references: [id], onDelete: Restrict)
  items           SupplementPlanItem[]

  // Composite coherence targets for the raw item/member FKs.
  @@unique([id, workspaceId])
  @@unique([id, workspaceId, clientProfileId])
  @@index([workspaceId])
  @@map("supplement_plan")
}

// Ordered rows — position is the coach-arranged order; the same product
// may appear more than once. The item embeds the catalogue snapshot the
// coach saw at save time, so later catalogue edits never alter a saved
// prescription (declared/reference fields stay NULL when the source had
// none — never zero-filled). Content CHECKs (positive quantity, bounded
// text) are raw migration SQL.
model SupplementPlanItem {
  id                String               @id @default(cuid())
  planId            String               @map("plan_id")
  workspaceId       String               @map("workspace_id")
  clientProfileId   String               @map("client_profile_id")
  position          Int
  itemRefId         String?              @map("item_ref_id")
  productRefId      String               @map("product_ref_id")
  brand             String
  productName       String               @map("product_name")
  referenceQuantity Decimal?             @map("reference_quantity") @db.Decimal(14, 4)
  quantityUnit      String?              @map("quantity_unit")
  declaredAmount    Decimal?             @map("declared_amount") @db.Decimal(14, 4)
  declaredUnit      String?              @map("declared_unit")
  productUrl        String?              @map("product_url")
  quantity          Decimal              @db.Decimal(14, 4)
  doseUnit          String               @map("dose_unit")
  timing            String
  status            SupplementItemStatus
  notes             String
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  plan          SupplementPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  clientProfile ClientProfile  @relation("SupplementPlanItemClient", fields: [clientProfileId], references: [id], onDelete: Restrict)

  @@unique([planId, position])
  @@unique([id, workspaceId])
  @@index([planId])
  @@index([workspaceId])
  @@map("supplement_plan_item")
}
