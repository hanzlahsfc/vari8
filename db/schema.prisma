// P-008: workspace-scoped onboarding form definitions — the mutable draft and
// immutable published snapshots only. No submission/intake tables exist in
// this slice by design. Restrict FKs: deleting a workspace/member must not
// cascade away form history.
enum OnboardingFormStatus {
  ACTIVE
  ARCHIVED
}

model OnboardingForm {
  id                   String               @id @default(cuid())
  workspaceId          String               @map("workspace_id")
  name                 String
  status               OnboardingFormStatus @default(ACTIVE)
  archivedAt           DateTime?            @map("archived_at") @db.Timestamptz(6)
  archivedByMemberId   String?              @map("archived_by_member_id")
  draft                Json?
  draftRevision        Int                  @default(1) @map("draft_revision")
  draftSavedByMemberId String?              @map("draft_saved_by_member_id")
  draftUpdatedAt       DateTime?            @map("draft_updated_at") @db.Timestamptz(6)
  createdByMemberId    String               @map("created_by_member_id")
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace        Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  createdByMember  WorkspaceMember            @relation("OnboardingFormCreator", fields: [createdByMemberId], references: [id], onDelete: Restrict)
  archivedByMember WorkspaceMember?           @relation("OnboardingFormArchiver", fields: [archivedByMemberId], references: [id], onDelete: Restrict)
  versions         OnboardingFormVersion[]
  assignments      OnboardingFormAssignment[] @relation("OnboardingAssignmentForm")
  submissions      OnboardingSubmission[]     @relation("OnboardingSubmissionForm")

  // Composite target for the OnboardingFormAssignment same-workspace foreign key (raw SQL).
  @@unique([id, workspaceId])
  @@index([workspaceId, status])
  @@map("onboarding_form")
}

model OnboardingFormVersion {
  id                    String   @id @default(cuid())
  formId                String   @map("form_id")
  versionSeq            Int      @map("version_seq")
  definition            Json
  publishOriginRevision Int      @map("publish_origin_revision")
  publishedAt           DateTime @default(now()) @map("published_at") @db.Timestamptz(6)
  publishedByMemberId   String   @map("published_by_member_id")

  form              OnboardingForm             @relation(fields: [formId], references: [id], onDelete: Restrict)
  publishedByMember WorkspaceMember            @relation("OnboardingFormVersionPublisher", fields: [publishedByMemberId], references: [id], onDelete: Restrict)
  assignments       OnboardingFormAssignment[] @relation("OnboardingAssignmentVersion")
  submissions       OnboardingSubmission[]     @relation("OnboardingSubmissionVersion")

  @@unique([formId, versionSeq])
  // Composite target for the OnboardingFormAssignment version∈form foreign key (raw SQL).
  @@unique([id, formId])
  @@index([formId, publishOriginRevision])
  @@map("onboarding_form_version")
}

// P-013: staff-only onboarding-form assignment records — client-associated
// operational metadata only (product-decisions #31–#34). Pins a client to one
// immutable published form version; stores NO answers. Lifecycle: ACTIVE makes
// exactly one terminal transition (SUPERSEDED | CANCELLED | future COMPLETED);
// provenance shape, one-ACTIVE-per-(ws,client,form) partial unique, and
// same-workspace/version-belongs-to-form composite foreign keys are enforced
// by raw SQL in the migration (Prisma cannot express them).
enum OnboardingAssignmentStatus {
  ACTIVE
  SUPERSEDED
  CANCELLED
  COMPLETED // schema-reserved for the future submission transaction; no P-013 service may set it
}

model OnboardingFormAssignment {
  id                 String                     @id @default(cuid())
  workspaceId        String                     @map("workspace_id")
  clientProfileId    String                     @map("client_profile_id")
  formId             String                     @map("form_id")
  formVersionId      String                     @map("form_version_id")
  status             OnboardingAssignmentStatus @default(ACTIVE)
  assignedByMemberId String                     @map("assigned_by_member_id")
  assignedAt         DateTime                   @default(now()) @map("assigned_at") @db.Timestamptz(6)
  endedByMemberId    String?                    @map("ended_by_member_id")
  endedAt            DateTime?                  @map("ended_at") @db.Timestamptz(6)
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace        Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  clientProfile    ClientProfile         @relation("OnboardingAssignmentClient", fields: [clientProfileId], references: [id], onDelete: Restrict)
  form             OnboardingForm        @relation("OnboardingAssignmentForm", fields: [formId], references: [id], onDelete: Restrict)
  formVersion      OnboardingFormVersion @relation("OnboardingAssignmentVersion", fields: [formVersionId], references: [id], onDelete: Restrict)
  assignedByMember WorkspaceMember       @relation("OnboardingAssignmentAssignedBy", fields: [assignedByMemberId], references: [id], onDelete: Restrict)
  endedByMember    WorkspaceMember?      @relation("OnboardingAssignmentEndedBy", fields: [endedByMemberId], references: [id], onDelete: Restrict)
  submission       OnboardingSubmission?

  // P-023: composite target for the submission's wide coherence foreign key —
  // the submission's workspace/client/form/pinned-version tuple must provably
  // belong to the referenced assignment (raw SQL FK). id-first implies the
  // (id, workspaceId) prefix target as well.
  @@unique([id, workspaceId, clientProfileId, formId, formVersionId])
  // (workspaceId, id) serves the workspace-scoped id-cursor pagination;
  // client/status and form/status serve scoped reads; formVersionId backs the
  // FK parent-delete scan. The ACTIVE cardinality lives in the raw partial
  // unique index "onboarding_assignment_one_active_key" (migration only).
  @@index([workspaceId, id])
  @@index([clientProfileId, status])
  @@index([formId, status])
  @@index([formVersionId])
  @@map("onboarding_form_assignment")
}

// ── P-014 parameter library + coaching template foundation (decisions #41–#48)
// Workspace-shared staff configuration only: no client data, no assignments,
// no formulas. Server-minted opaque keys; immutable published snapshots.

enum ParameterKind {
  MEASUREMENT
  RATING
  TIME
  DURATION
  OPTION
  TEXT
  // PR-M0: additional canvas input kinds.
  BLOOD_PRESSURE
  LOCATION_RATING
  CONTEXT
  MULTI_CHOICE
}

enum RatingScheme {
  SCALE_1_10
  SCALE_1_5
  WORD_LABELS
}

enum ParameterStatus {
  ACTIVE
  ARCHIVED
}

enum ParameterDataClassification {
  GENERAL_HEALTH
  CYCLE
  BLOODWORK
  PED_HRT
}

enum CoachingTemplateStatus {
  ACTIVE
  ARCHIVED
}

model ParameterDefinition {
  id                 String                       @id @default(cuid())
  workspaceId        String                       @map("workspace_id")
  // Server-minted opaque key (p_<uuid>) — immutable, never reusable.
  key                String
  // Kind is immutable from creation (no service path writes it).
  kind               ParameterKind
  // Display metadata — editable with revision even after first publish.
  label              String
  helpText           String?                      @map("help_text")
  group              String?                      @map("group_label")
  // Semantic metadata — locked after first published reference.
  unit               String?
  ratingScheme       RatingScheme?                @map("rating_scheme")
  options            Json?
  retiredOptionIds   Json?                        @map("retired_option_ids")
  // Closed declarative numeric bounds only; semantic field.
  validation         Json?
  // P-020A (decisions #73/#78): closed data classification — no default, no
  // backfill; NULL until the explicit audited classification action runs.
  // BLOODWORK/PED_HRT are unassignable by every application role.
  dataClassification ParameterDataClassification? @map("data_classification")
  revision           Int                          @default(1)
  status             ParameterStatus              @default(ACTIVE)
  createdByMemberId  String                       @map("created_by_member_id")
  updatedByMemberId  String                       @map("updated_by_member_id")
  archivedAt         DateTime?                    @map("archived_at") @db.Timestamptz(6)
  archivedByMemberId String?                      @map("archived_by_member_id")
  createdAt          DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace         Workspace                          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  createdByMember   WorkspaceMember                    @relation("ParameterDefinitionCreator", fields: [createdByMemberId], references: [id], onDelete: Restrict)
  updatedByMember   WorkspaceMember                    @relation("ParameterDefinitionUpdater", fields: [updatedByMemberId], references: [id], onDelete: Restrict)
  archivedByMember  WorkspaceMember?                   @relation("ParameterDefinitionArchiver", fields: [archivedByMemberId], references: [id], onDelete: Restrict)
  versionReferences CoachingTemplateVersionParameter[]
  dailyEntryValues  DailyEntryRevisionValue[]
  // PR-M0: tracker comments and client goals reference parameters.
  trackerComments   TrackerComment[]                   @relation("TrackerCommentParameter")
  clientGoals       ClientGoal[]                       @relation("ClientGoalParameter")

  @@unique([workspaceId, key])
  // Composite target for same-workspace foreign keys (raw SQL).
  @@unique([id, workspaceId])
  @@index([workspaceId, status])
  @@map("parameter_definition")
}

model CoachingTemplate {
  id                   String                 @id @default(cuid())
  workspaceId          String                 @map("workspace_id")
  // Duplicate display names are permitted (decision #46) — IDs authoritative.
  name                 String
  // PR-M0: coach-facing description + D24 soft-delete restore window.
  // The restore pairing/ordering CHECKs and the summaryParameterIds draft
  // bound are raw migration SQL.
  description          String                 @default("")
  deletedAt            DateTime?              @map("deleted_at") @db.Timestamptz(6)
  restoreUntil         DateTime?              @map("restore_until") @db.Timestamptz(6)
  status               CoachingTemplateStatus @default(ACTIVE)
  archivedAt           DateTime?              @map("archived_at") @db.Timestamptz(6)
  archivedByMemberId   String?                @map("archived_by_member_id")
  draft                Json?
  draftRevision        Int                    @default(1) @map("draft_revision")
  draftSavedByMemberId String?                @map("draft_saved_by_member_id")
  draftUpdatedAt       DateTime?              @map("draft_updated_at") @db.Timestamptz(6)
  createdByMemberId    String                 @map("created_by_member_id")
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace         Workspace                          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  createdByMember   WorkspaceMember                    @relation("CoachingTemplateCreator", fields: [createdByMemberId], references: [id], onDelete: Restrict)
  archivedByMember  WorkspaceMember?                   @relation("CoachingTemplateArchiver", fields: [archivedByMemberId], references: [id], onDelete: Restrict)
  versions          CoachingTemplateVersion[]
  versionReferences CoachingTemplateVersionParameter[]
  clientSetupPins   ClientSetupPin[]                   @relation("ClientSetupPinTemplate")

  // Composite target for same-workspace foreign keys (raw SQL).
  @@unique([id, workspaceId])
  @@index([workspaceId, status])
  @@map("coaching_template")
}

model CoachingTemplateVersion {
  id                    String   @id @default(cuid())
  workspaceId           String   @map("workspace_id")
  templateId            String   @map("template_id")
  versionSeq            Int      @map("version_seq")
  // Frozen structure + embedded parameter metadata — never mutates.
  definition            Json
  // Publish replay key: same origin revision returns the same version.
  publishOriginRevision Int      @map("publish_origin_revision")
  publishedAt           DateTime @default(now()) @map("published_at") @db.Timestamptz(6)
  publishedByMemberId   String   @map("published_by_member_id")

  workspace           Workspace                          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  template            CoachingTemplate                   @relation(fields: [templateId], references: [id], onDelete: Restrict)
  publishedByMember   WorkspaceMember                    @relation("CoachingTemplateVersionPublisher", fields: [publishedByMemberId], references: [id], onDelete: Restrict)
  parameters          CoachingTemplateVersionParameter[]
  clientSetupPins     ClientSetupPin[]                   @relation("ClientSetupPinVersion")
  dailyEntryRevisions DailyEntryRevision[]

  @@unique([templateId, versionSeq])
  @@unique([templateId, publishOriginRevision])
  // Composite targets for coherence foreign keys (raw SQL):
  // (id, workspace_id) version↔workspace; (id, template_id, workspace_id)
  // version↔template↔workspace.
  @@unique([id, workspaceId])
  @@unique([id, templateId, workspaceId])
  @@map("coaching_template_version")
}

model CoachingTemplateVersionParameter {
  workspaceId String @map("workspace_id")
  templateId  String @map("template_id")
  versionId   String @map("version_id")
  parameterId String @map("parameter_id")

  workspace Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  template  CoachingTemplate        @relation(fields: [templateId], references: [id], onDelete: Restrict)
  version   CoachingTemplateVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  parameter ParameterDefinition     @relation(fields: [parameterId], references: [id], onDelete: Restrict)

  @@id([versionId, parameterId])
  // Backs the post-publish semantic-lock EXISTS check and reverse usage.
  @@index([parameterId])
  @@map("coaching_template_version_parameter")
}

// ── P-016 C1 client setup + template assignments (product-decisions #49–#57)
// ClientSetup is the stable per-client configuration aggregate — it survives
// cancellation and reassignment and never carries a status. ClientSetupPin is
// the append-only assignment/version-pin history: exactly one ACTIVE pin per
// setup, immutable (templateId, templateVersionId, assignedBy, assignedAt)
// tuple, exactly one terminal transition (CANCELLED in C1; SUPERSEDED is
// schema-reserved for C2). Same-workspace coherence, setup↔pin membership,
// version∈template∈workspace pinning, provenance shape, the one-ACTIVE
// partial unique, and the (clientSetupId, seq) backstop are enforced by raw
// SQL in the migration (Prisma cannot express them).

enum ClientSetupPinStatus {
  ACTIVE
  SUPERSEDED // schema-reserved for C2 transitions; no C1 service may set it
  CANCELLED
}

// P-020B (decisions #58–#62): transition kind for superseded-by-transition
// successor pins. NULL on every C1 (initial assignment / cancel) pin.
enum PinTransitionKind {
  UPGRADE
  ROLLBACK
}

model ClientSetup {
  id              String   @id @default(cuid())
  workspaceId     String   @map("workspace_id")
  clientProfileId String   @map("client_profile_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  clientProfile ClientProfile    @relation("ClientSetupClient", fields: [clientProfileId], references: [id], onDelete: Restrict)
  pins          ClientSetupPin[]

  // One stable setup per (workspace, client) — created on first assignment,
  // reused by every later pin (decision #49). The two composite uniques are
  // targets for the pin's setup∈workspace and pin.client↔setup.client
  // foreign keys (raw SQL).
  @@unique([workspaceId, clientProfileId])
  @@unique([id, workspaceId])
  @@unique([id, clientProfileId])
  @@index([clientProfileId])
  @@map("client_setup")
}

model ClientSetupPin {
  id                 String               @id @default(cuid())
  clientSetupId      String               @map("client_setup_id")
  workspaceId        String               @map("workspace_id")
  clientProfileId    String               @map("client_profile_id")
  // Per-setup append-only ordering, allocated as max(seq)+1 under the
  // per-client advisory lock + aggregate row lock (never the audit
  // meta.version — that carries the pinned template versionSeq).
  seq                Int
  templateId         String               @map("template_id")
  templateVersionId  String               @map("template_version_id")
  status             ClientSetupPinStatus @default(ACTIVE)
  assignedByMemberId String               @map("assigned_by_member_id")
  assignedAt         DateTime             @default(now()) @map("assigned_at") @db.Timestamptz(6)
  endedByMemberId    String?              @map("ended_by_member_id")
  endedAt            DateTime?            @map("ended_at") @db.Timestamptz(6)
  // P-020B C2 lineage: a successor pin records which pin it supersedes, the
  // transition direction, and the structural-only summary. All three are
  // NULL on initial-assignment pins; all three non-NULL on transition pins
  // (coupled + shape CHECKs in the migration's raw SQL).
  supersedesPinId    String?              @unique @map("supersedes_pin_id")
  transitionKind     PinTransitionKind?   @map("transition_kind")
  transitionSummary  Json?                @map("transition_summary")
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  clientSetup      ClientSetup             @relation(fields: [clientSetupId], references: [id], onDelete: Restrict)
  supersedesPin    ClientSetupPin?         @relation("PinSupersession", fields: [supersedesPinId], references: [id], onDelete: Restrict)
  supersededByPin  ClientSetupPin?         @relation("PinSupersession")
  workspace        Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  clientProfile    ClientProfile           @relation("ClientSetupPinClient", fields: [clientProfileId], references: [id], onDelete: Restrict)
  template         CoachingTemplate        @relation("ClientSetupPinTemplate", fields: [templateId], references: [id], onDelete: Restrict)
  templateVersion  CoachingTemplateVersion @relation("ClientSetupPinVersion", fields: [templateVersionId], references: [id], onDelete: Restrict)
  assignedByMember WorkspaceMember         @relation("ClientSetupPinAssignedBy", fields: [assignedByMemberId], references: [id], onDelete: Restrict)
  endedByMember    WorkspaceMember?        @relation("ClientSetupPinEndedBy", fields: [endedByMemberId], references: [id], onDelete: Restrict)

  dailyEntryRevisions DailyEntryRevision[]

  // (workspaceId, id) serves the workspace-scoped id-cursor pagination;
  // client/status and template/status serve scoped reads; versionId backs
  // the FK parent-delete scan. The ACTIVE cardinality lives in the raw
  // partial unique index "client_setup_pin_one_active_key" (migration only).
  @@unique([clientSetupId, seq])
  // Composite target for the same-setup lineage foreign key (raw SQL).
  @@unique([id, clientSetupId])
  // P-021: composite targets for DailyEntry revision→pin coherence foreign
  // keys (raw SQL) — pin+workspace+version identity and pin+client equality.
  @@unique([id, workspaceId, templateVersionId])
  @@unique([id, clientProfileId])
  @@index([workspaceId, id])
  @@index([clientProfileId, status])
  @@index([templateId, status])
  @@index([templateVersionId])
  @@map("client_setup_pin")
}

// ── P-021 DailyEntry (decisions #64–#78) ──────────────────────────────────
// One logical entry per (workspace, client, declared DATE) with append-only
// revisions and a current-revision pointer. Composite coherence foreign keys
// (entry↔client+workspace, revision↔entry/pin/creator, value↔revision/
// parameter, pointer→own revision) live in the migration's raw SQL.

model DailyEntry {
  id                String   @id @default(cuid())
  workspaceId       String   @map("workspace_id")
  clientProfileId   String   @map("client_profile_id")
  // Declared client calendar date (#66) — DATE column, no timezone column.
  entryDate         DateTime @map("entry_date") @db.Date
  // Nullable at insert; set to the first revision inside the same
  // transaction. The composite pointer foreign key
  // (current_revision_id, id) → daily_entry_revision(id, daily_entry_id)
  // is raw SQL — Prisma cannot express the cyclic composite relation.
  currentRevisionId String?  @map("current_revision_id")
  createdByMemberId String   @map("created_by_member_id")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace       Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  clientProfile   ClientProfile        @relation("ClientProfileDailyEntries", fields: [clientProfileId], references: [id], onDelete: Restrict)
  createdByMember WorkspaceMember      @relation("DailyEntryCreator", fields: [createdByMemberId], references: [id], onDelete: Restrict)
  revisions       DailyEntryRevision[]
  nutritionLog    NutritionLog?

  // One logical entry per client per declared date (#65).
  @@unique([workspaceId, clientProfileId, entryDate])
  // Composite targets for same-workspace / entry-coherence foreign keys
  // (raw SQL).
  @@unique([id, workspaceId])
  @@unique([id, clientProfileId])
  @@unique([id, workspaceId, clientProfileId])
  @@index([clientProfileId, entryDate])
  @@map("daily_entry")
}

model DailyEntryRevision {
  id                String   @id @default(cuid())
  dailyEntryId      String   @map("daily_entry_id")
  workspaceId       String   @map("workspace_id")
  clientProfileId   String   @map("client_profile_id")
  // Write-time pin + version lineage — never rewritten by later C2
  // transitions; historical semantics render from the immutable version
  // definition (P-021-R3 §10).
  clientSetupPinId  String   @map("client_setup_pin_id")
  templateVersionId String   @map("template_version_id")
  // Per-entry append-only order, allocated max(seq)+1 under the entry lock.
  seq               Int
  // Entry-local dedup identity (DAILY-ENTRY-REV-v1 canonical encoding).
  canonicalHash     String   @map("canonical_hash")
  declaredAt        DateTime @map("declared_at") @db.Timestamptz(6)
  createdByMemberId String   @map("created_by_member_id")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  entry           DailyEntry                @relation(fields: [dailyEntryId], references: [id], onDelete: Restrict)
  pin             ClientSetupPin            @relation(fields: [clientSetupPinId], references: [id], onDelete: Restrict)
  templateVersion CoachingTemplateVersion   @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  createdByMember WorkspaceMember           @relation("DailyEntryRevisionCreator", fields: [createdByMemberId], references: [id], onDelete: Restrict)
  values          DailyEntryRevisionValue[]

  @@unique([dailyEntryId, seq])
  // Composite targets for coherence foreign keys (raw SQL): pointer→own
  // revision, value→revision+workspace, revision→pin+workspace+version,
  // revision→pin+client.
  @@unique([id, dailyEntryId])
  @@unique([id, workspaceId])
  @@unique([id, clientProfileId])
  @@index([clientSetupPinId])
  @@index([clientProfileId])
  @@index([dailyEntryId, declaredAt])
  @@map("daily_entry_revision")
}

model DailyEntryRevisionValue {
  revisionId     String        @map("revision_id")
  workspaceId    String        @map("workspace_id")
  parameterId    String        @map("parameter_id")
  // Closed ParameterKind — the exactly-one-column CHECK in raw SQL makes
  // unsupported kinds incapable of producing a row.
  kind           ParameterKind
  valueNumeric   Decimal?      @map("value_numeric") @db.Decimal(30, 8)
  valueRating    Int?          @map("value_rating")
  valueOptionId  String?       @map("value_option_id")
  valueText      String?       @map("value_text")
  // PR-M0 (D28): value columns for the added ParameterKinds. The ten-branch
  // kind/column CHECK is raw migration SQL.
  valueMinutes   Int?          @map("value_minutes")
  valueSystolic  Int?          @map("value_systolic") @db.SmallInt
  valueDiastolic Int?          @map("value_diastolic") @db.SmallInt
  valueOptionIds Json?         @map("value_option_ids")

  revision  DailyEntryRevision  @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  parameter ParameterDefinition @relation(fields: [parameterId], references: [id], onDelete: Restrict)

  // One value per parameter per revision (#64).
  @@id([revisionId, parameterId])
  @@index([parameterId])
  @@map("daily_entry_revision_value")
}

// Card 09 (#173): daily nutrition actuals over daily entries. One log per
// day entry with three independent nullable macro columns - NULL reads as
// not recorded, never zero. Calories are derived at read (4/4/9); no
// entered or stored calorie column exists by design. The log is pinned to
// the day entry, not to any template pin or nutrition mode, so switching
// a client between meal plan and macro counting keeps earlier entries.
model NutritionLog {
  id                String   @id @default(cuid())
  dailyEntryId      String   @map("daily_entry_id")
  workspaceId       String   @map("workspace_id")
  clientProfileId   String   @map("client_profile_id")
  entryDate         DateTime @map("entry_date") @db.Date
  protein           Decimal? @db.Decimal(9, 3)
  carbohydrate      Decimal? @db.Decimal(9, 3)
  fat               Decimal? @db.Decimal(9, 3)
  createdByMemberId String   @map("created_by_member_id")
  updatedByMemberId String   @map("updated_by_member_id")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  dailyEntry      DailyEntry      @relation(fields: [dailyEntryId], references: [id], onDelete: Restrict)
  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  clientProfile   ClientProfile   @relation("ClientProfileNutritionLogs", fields: [clientProfileId], references: [id], onDelete: Restrict)
  createdByMember WorkspaceMember @relation("NutritionLogCreator", fields: [createdByMemberId], references: [id], onDelete: Restrict)
  updatedByMember WorkspaceMember @relation("NutritionLogUpdater", fields: [updatedByMemberId], references: [id], onDelete: Restrict)

  // One log per day entry and per client day; (id, workspace_id) is the
  // coherence target for tenant-scoped foreign keys in raw SQL.
  @@unique([dailyEntryId])
  @@unique([workspaceId, clientProfileId, entryDate])
  @@unique([id, workspaceId])
  @@index([clientProfileId, entryDate])
  @@map("nutrition_log")
}

// P-023 (decisions #82–#85): client onboarding submission. Exactly one
// immutable submission per assignment; answers are revision-free immutable
// rows. Tenant coherence is enforced by composite foreign keys in the raw
// migration; ACTIVE/ownership/idempotency are service-enforced under locks.
enum OnboardingAnswerKind {
  SHORT_TEXT
  LONG_TEXT
  NUMBER
  DATE
  SINGLE_CHOICE
  MULTI_CHOICE
}

model OnboardingSubmission {
  id                  String   @id @default(cuid())
  workspaceId         String   @map("workspace_id")
  clientProfileId     String   @map("client_profile_id")
  formId              String   @map("form_id")
  formVersionId       String   @map("form_version_id")
  assignmentId        String   @map("assignment_id")
  submittedByUserId   String   @map("submitted_by_user_id")
  submittedByMemberId String   @map("submitted_by_member_id")
  submittedAt         DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace         Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  clientProfile     ClientProfile                @relation("OnboardingSubmissionClient", fields: [clientProfileId], references: [id], onDelete: Restrict)
  form              OnboardingForm               @relation("OnboardingSubmissionForm", fields: [formId], references: [id], onDelete: Restrict)
  formVersion       OnboardingFormVersion        @relation("OnboardingSubmissionVersion", fields: [formVersionId], references: [id], onDelete: Restrict)
  assignment        OnboardingFormAssignment     @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  submittedByUser   User                         @relation("OnboardingSubmissionSubmittedByUser", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  submittedByMember WorkspaceMember              @relation("OnboardingSubmissionSubmittedByMember", fields: [submittedByMemberId], references: [id], onDelete: Restrict)
  answers           OnboardingSubmissionAnswer[]
  review            OnboardingSubmissionReview?

  // At-most-one durable submission per assignment — the idempotency anchor
  // and final concurrency authority (P2002 → abort → retry hits the
  // existing-submission shortcut in a fresh transaction).
  @@unique([assignmentId])
  // Composite target for the answer same-workspace foreign key (raw SQL).
  @@unique([id, workspaceId])
  // P-024: composite target for the review's (submission, workspace,
  // client) coherence foreign key (raw SQL). `id` already implies
  // uniqueness; the wider key exists specifically so a review row can
  // never drift outside its submission's client/workspace tuple.
  @@unique([id, workspaceId, clientProfileId])
  // Own-assignment discovery list and the workspace-scoped id-cursor convention.
  @@index([workspaceId, clientProfileId])
  @@index([workspaceId, id])
  @@map("onboarding_submission")
}

model OnboardingSubmissionAnswer {
  id             String               @id @default(cuid())
  submissionId   String               @map("submission_id")
  workspaceId    String               @map("workspace_id")
  fieldId        String               @map("field_id")
  kind           OnboardingAnswerKind
  valueText      String?              @map("value_text")
  valueNumeric   Decimal?             @map("value_numeric") @db.Decimal(23, 6)
  valueDate      DateTime?            @map("value_date") @db.Date
  valueOptionIds Json?                @map("value_option_ids")

  submission OnboardingSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  workspace  Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  // One answer per field per submission. The kind↔column shape is a raw
  // CHECK in the migration (Prisma cannot express it); immutability is
  // service contract — no write path ever updates these rows.
  @@unique([submissionId, fieldId])
  @@index([workspaceId])
  @@map("onboarding_submission_answer")
}

// P-024 — staff onboarding-submission review acknowledgement (decision
// #86: one workspace-terminal review per submission; immutable
// provenance only — who and when. No notes, no feedback, no workflow
// gate; submission and answer rows are never mutated.)
model OnboardingSubmissionReview {
  id                 String   @id @default(cuid())
  workspaceId        String   @map("workspace_id")
  clientProfileId    String   @map("client_profile_id")
  submissionId       String   @map("submission_id")
  reviewedByMemberId String   @map("reviewed_by_member_id")
  reviewedAt         DateTime @default(now()) @map("reviewed_at") @db.Timestamptz(6)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  // Immutable — no updatedAt (terminal acknowledgement).

  workspace        Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  clientProfile    ClientProfile        @relation("OnboardingReviewClient", fields: [clientProfileId], references: [id], onDelete: Restrict)
  submission       OnboardingSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  reviewedByMember WorkspaceMember      @relation("OnboardingReviewReviewer", fields: [reviewedByMemberId], references: [id], onDelete: Restrict)

  // #86 workspace-terminal anchor — at most one review per submission;
  // idempotency + final concurrency authority.
  @@unique([submissionId])
  @@index([workspaceId, clientProfileId])
  @@index([workspaceId, id])
  @@map("onboarding_submission_review")
}

// ── P-025-A Check-In form definitions (decisions #92–#97) ──────────────────
// Staff-managed Check-In form definitions + immutable published versions.
// Check-In is a DISTINCT domain from onboarding — its own tables, enum,
// kinds, and lifecycle. No instance/scheduling/submission/review tables in
// this slice (P-025-B+); no client answers exist anywhere. Restrict FKs:
// deleting a workspace/member must not cascade away form history.

enum CheckInFormStatus {
  ACTIVE
  ARCHIVED
}

// Domain answer-kind vocabulary for future CheckInSubmissionAnswer rows and
// the kind strings recorded in published definition snapshots. Never the
// onboarding-named enum.
enum CheckInAnswerKind {
  SHORT_TEXT
  LONG_TEXT
  NUMBER
  DATE
  SINGLE_CHOICE
  MULTI_CHOICE
  // PR-M0: rating and visual-upload answers.
  RATING
  VISUAL
}

model CheckInForm {
  id                   String            @id @default(cuid())
  workspaceId          String            @map("workspace_id")
  name                 String
  status               CheckInFormStatus @default(ACTIVE)
  archivedAt           DateTime?         @map("archived_at") @db.Timestamptz(6)
  archivedByMemberId   String?           @map("archived_by_member_id")
  // Mutable working draft (open/closed lifecycle mirrors onboarding):
  // publish sets it to null; openCheckInDraft seeds the next revision from
  // the LATEST immutable version. Optimistic concurrency via draftRevision.
  draft                Json?
  draftRevision        Int               @default(1) @map("draft_revision")
  draftSavedByMemberId String?           @map("draft_saved_by_member_id")
  draftUpdatedAt       DateTime?         @map("draft_updated_at") @db.Timestamptz(6)
  createdByMemberId    String            @map("created_by_member_id")
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace        Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  createdByMember  WorkspaceMember       @relation("CheckInFormCreator", fields: [createdByMemberId], references: [id], onDelete: Restrict)
  archivedByMember WorkspaceMember?      @relation("CheckInFormArchiver", fields: [archivedByMemberId], references: [id], onDelete: Restrict)
  versions         CheckInFormVersion[]
  instances        CheckInInstance[]     @relation("CheckInInstanceForm")
  submissions      CheckInSubmission[]   @relation("CheckInSubmissionForm")
  scheduleRules    CheckInScheduleRule[] @relation("CheckInScheduleRuleForm")

  // Composite target for the CheckInFormVersion form∈workspace foreign key (raw SQL).
  @@unique([id, workspaceId])
  @@index([workspaceId, status])
  @@map("checkin_form")
}

model CheckInFormVersion {
  id                    String   @id @default(cuid())
  // Denormalized tenant stamp — immutable, set at publish; part of the
  // (id, workspaceId, formId) composite coherence target below.
  workspaceId           String   @map("workspace_id")
  formId                String   @map("form_id")
  versionSeq            Int      @map("version_seq")
  definition            Json
  publishOriginRevision Int      @map("publish_origin_revision")
  publishedAt           DateTime @default(now()) @map("published_at") @db.Timestamptz(6)
  publishedByMemberId   String   @map("published_by_member_id")

  workspace         Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  form              CheckInForm         @relation(fields: [formId], references: [id], onDelete: Restrict)
  publishedByMember WorkspaceMember     @relation("CheckInFormVersionPublisher", fields: [publishedByMemberId], references: [id], onDelete: Restrict)
  instances         CheckInInstance[]   @relation("CheckInInstanceFormVersion")
  submissions       CheckInSubmission[] @relation("CheckInSubmissionFormVersion")

  @@unique([formId, versionSeq])
  // Composite coherence target for later client-scoped rows (raw SQL FKs in
  // a future migration when instance/submission tables arrive).
  @@unique([id, workspaceId, formId])
  // Deterministic publish-replay authority: one version per origin draft
  // revision (declared unique — matches the raw migration index name).
  @@unique([formId, publishOriginRevision], map: "checkin_form_version_publish_origin_key")
  @@map("checkin_form_version")
}

// ── P-025-B Check-In instances + client submissions (decisions #92–#97) ──
// One-off scheduled instances (no recurrence/calendar — #92), immutable
// submissions + typed answers. NO stored lifecycle status: effective state
// derives from cancellation provenance + child submission rows through one
// shared projector (§10). All history/provenance FKs are RESTRICT; the wide
// composite coherence FKs + the paired-provenance and kind↔column CHECKs
// are raw migration SQL (the established convention — Prisma cannot express
// them). No CheckInReview in this slice (P-025-C).

model CheckInInstance {
  id                  String    @id @default(cuid())
  workspaceId         String    @map("workspace_id")
  clientProfileId     String    @map("client_profile_id")
  formId              String    @map("form_id")
  formVersionId       String    @map("form_version_id")
  dueAt               DateTime  @map("due_at") @db.Timestamptz(6)
  // Optional forward-compat label only — NOT a timezone policy (#93/Q2).
  dueTz               String?   @map("due_tz")
  scheduledByMemberId String    @map("scheduled_by_member_id")
  scheduledAt         DateTime  @default(now()) @map("scheduled_at") @db.Timestamptz(6)
  // CHECK-IN-RECURRENCE-I1 (decision #114): generation provenance — the
  // rule that produced this occurrence + the intended LOCAL calendar date
  // (invariant under DST due-instant shifts). Both null or both non-null
  // (raw CHECK); manual one-off rows carry neither. The raw composite FK
  // (origin_rule_id, workspace_id, client_profile_id) →
  // checkin_schedule_rule(id, workspace_id, client_profile_id) makes a
  // generated row incoherent to any other client/workspace tuple.
  originRuleId        String?   @map("origin_rule_id")
  occurrenceDate      DateTime? @map("occurrence_date") @db.Date
  // Paired cancellation provenance — both null or both non-null (raw CHECK).
  // A cancellation is the only permitted mutation on this row.
  cancelledByMemberId String?   @map("cancelled_by_member_id")
  cancelledAt         DateTime? @map("cancelled_at") @db.Timestamptz(6)
  // PR-M0: coach note on the instance + D24 additional-date removal undo
  // window (pairing/order CHECK is raw migration SQL).
  coachNote           String?   @map("coach_note")
  cancelRestoreUntil  DateTime? @map("cancel_restore_until") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace         Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  clientProfile     ClientProfile        @relation("CheckInInstanceClient", fields: [clientProfileId], references: [id], onDelete: Restrict)
  form              CheckInForm          @relation("CheckInInstanceForm", fields: [formId], references: [id], onDelete: Restrict)
  formVersion       CheckInFormVersion   @relation("CheckInInstanceFormVersion", fields: [formVersionId], references: [id], onDelete: Restrict)
  scheduledByMember WorkspaceMember      @relation("CheckInInstanceScheduler", fields: [scheduledByMemberId], references: [id], onDelete: Restrict)
  cancelledByMember WorkspaceMember?     @relation("CheckInInstanceCanceller", fields: [cancelledByMemberId], references: [id], onDelete: Restrict)
  originRule        CheckInScheduleRule? @relation(fields: [originRuleId], references: [id], onDelete: Restrict)
  submissions       CheckInSubmission[]

  // Wide composite coherence target for the submission's full-tuple FK
  // (raw SQL): the pinned (id, workspaceId, clientProfileId, formId,
  // formVersionId) tuple can never drift apart.
  @@unique([id, workspaceId, clientProfileId, formId, formVersionId], map: "checkin_instance_wide_coherence_key")
  // Duplicate-scheduling authority: one instance per (client, form, dueAt).
  @@unique([workspaceId, clientProfileId, formId, dueAt], map: "checkin_instance_duplicate_schedule_key")
  // Occurrence identity: at most one generated row per (rule, local date).
  // Multi-NULL safe — manual rows (both null) never collide.
  @@unique([originRuleId, occurrenceDate], map: "checkin_instance_occurrence_key")
  @@index([workspaceId, clientProfileId, dueAt])
  @@index([workspaceId, id])
  @@index([formVersionId])
  @@index([originRuleId])
  @@map("checkin_instance")
}

model CheckInSubmission {
  id                  String   @id @default(cuid())
  workspaceId         String   @map("workspace_id")
  clientProfileId     String   @map("client_profile_id")
  formId              String   @map("form_id")
  formVersionId       String   @map("form_version_id")
  instanceId          String   @map("instance_id")
  submittedByUserId   String   @map("submitted_by_user_id")
  submittedByMemberId String   @map("submitted_by_member_id")
  submittedAt         DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  // Immutable — no updatedAt (P-024 P3-1 terminal-immutability precedent).

  workspace         Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  clientProfile     ClientProfile             @relation("CheckInSubmissionClient", fields: [clientProfileId], references: [id], onDelete: Restrict)
  form              CheckInForm               @relation("CheckInSubmissionForm", fields: [formId], references: [id], onDelete: Restrict)
  formVersion       CheckInFormVersion        @relation("CheckInSubmissionFormVersion", fields: [formVersionId], references: [id], onDelete: Restrict)
  instance          CheckInInstance           @relation(fields: [instanceId], references: [id], onDelete: Restrict)
  submittedByUser   User                      @relation("CheckInSubmissionSubmittedByUser", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  submittedByMember WorkspaceMember           @relation("CheckInSubmissionSubmittedByMember", fields: [submittedByMemberId], references: [id], onDelete: Restrict)
  answers           CheckInSubmissionAnswer[]
  reviews           CheckInReview[]
  feedback          CheckInFeedback[]
  progressPhotos    ProgressPhotoEntry[]      @relation("ProgressPhotoEntrySubmission")

  // At-most-one durable submission per instance — idempotency anchor and
  // final concurrency authority (P2002 → bounded full-protocol re-entry).
  @@unique([instanceId])
  // Composite target for the answer same-(workspace,client) coherence FK
  // (raw SQL) — an answer can never drift to a foreign submission tuple.
  @@unique([id, workspaceId, clientProfileId], map: "checkin_submission_coherence_key")
  @@index([workspaceId, clientProfileId])
  @@index([workspaceId, id])
  // CHECK-IN-OVERVIEW-I1: workspace-level awaiting-review queue ordered
  // submittedAt ASC,id ASC — the reviewed-history tail grows unbounded
  // without this keyset index.
  @@index([workspaceId, submittedAt, id])
  @@map("checkin_submission")
}

model CheckInSubmissionAnswer {
  id              String            @id @default(cuid())
  submissionId    String            @map("submission_id")
  workspaceId     String            @map("workspace_id")
  clientProfileId String            @map("client_profile_id")
  fieldId         String            @map("field_id")
  kind            CheckInAnswerKind
  valueText       String?           @map("value_text")
  valueNumeric    Decimal?          @map("value_numeric") @db.Decimal(23, 6)
  valueDate       DateTime?         @map("value_date") @db.Date
  valueOptionIds  Json?             @map("value_option_ids")
  // PR-M0: RATING answers; VISUAL answers carry no value columns (media in
  // checkin_answer_media). The extended kind↔column CHECK is raw SQL.
  valueRating     Int?              @map("value_rating")

  submission    CheckInSubmission    @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  workspace     Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  clientProfile ClientProfile        @relation("CheckInAnswerClient", fields: [clientProfileId], references: [id], onDelete: Restrict)
  media         CheckInAnswerMedia[]

  // One answer per field per submission. kind↔column shape is a raw CHECK
  // in the migration (Prisma cannot express it); immutability is a service
  // contract — no write path ever updates these rows.
  @@unique([submissionId, fieldId])
  // Composite target for the answer-media same-workspace FK (raw SQL).
  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@map("checkin_submission_answer")
}

// P-025-C — staff review acknowledgement (decision #86: one
// workspace-terminal review per submission; immutable provenance only —
// who and when. No notes, no feedback, no workflow gate.)
model CheckInReview {
  id                 String   @id @default(cuid())
  workspaceId        String   @map("workspace_id")
  clientProfileId    String   @map("client_profile_id")
  submissionId       String   @map("submission_id")
  reviewedByMemberId String   @map("reviewed_by_member_id")
  reviewedAt         DateTime @default(now()) @map("reviewed_at") @db.Timestamptz(6)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  // Immutable — no updatedAt (terminal acknowledgement, P-024 precedent).

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  clientProfile    ClientProfile     @relation("CheckInReviewClient", fields: [clientProfileId], references: [id], onDelete: Restrict)
  submission       CheckInSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  reviewedByMember WorkspaceMember   @relation("CheckInReviewReviewer", fields: [reviewedByMemberId], references: [id], onDelete: Restrict)

  // #86-analog workspace-terminal anchor — at most one review per
  // submission, idempotency + final concurrency authority.
  @@unique([submissionId])
  @@index([workspaceId, clientProfileId])
  @@map("checkin_review")
}

// CHECK-IN-FEEDBACK-I1 (decision pending — reviewed P3 contract; #101
// direction, owner answers: same consent gate as answers; author
// departure persists rows for currently authorized readers only).
// Append-only staff-authored plain-text feedback anchored to an exact
// submission; a CheckInReview must exist first (service-enforced).
// Multiple rows per submission = dated follow-ups. No updatedAt —
// immutable once committed; no read/seen tracking anywhere.
model CheckInFeedback {
  id                 String   @id @default(cuid())
  workspaceId        String   @map("workspace_id")
  clientProfileId    String   @map("client_profile_id")
  submissionId       String   @map("submission_id")
  authoredByMemberId String   @map("authored_by_member_id")
  body               String
  clientRequestId    String   @map("client_request_id")
  sentAt             DateTime @default(now()) @map("sent_at") @db.Timestamptz(6)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  clientProfile ClientProfile     @relation("CheckInFeedbackClient", fields: [clientProfileId], references: [id], onDelete: Restrict)
  submission    CheckInSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  authoredBy    WorkspaceMember   @relation("CheckInFeedbackAuthor", fields: [authoredByMemberId], references: [id], onDelete: Restrict)

  // Idempotency anchor — at most one durable row per (submission,
  // client-generated nonce); per-submission scoping means the same
  // nonce on another submission is a separate key by design.
  @@unique([submissionId, clientRequestId])
  // ASC keyset pagination: (sentAt, id) deterministic order.
  @@index([submissionId, sentAt, id])
  @@index([workspaceId, clientProfileId])
  @@map("checkin_feedback")
}

enum CheckInScheduleRuleStatus {
  ACTIVE
  PAUSED
  ENDED
}

enum CheckInWeekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// CHECK-IN-RECURRENCE-I1 (decision #114 — owner-approved bounded first
// version): one weekday per week at a chosen local time in the
// coach-CONFIRMED IANA timezone. NOT a scheduler — instances only exist
// after an explicit authorized staff generation action (8-week horizon,
// T+56 inclusive). Pause blocks generation; End is terminal and cancels
// still-unsubmitted generated occurrences. No in-place edits — schedule
// changes end this row and create a replacement (replacedByRuleId link).
// Raw CHECKs (migration): local_time_minutes 0–1439; end_date >=
// start_date; ended provenance paired non-null.
model CheckInScheduleRule {
  id                String                    @id @default(cuid())
  workspaceId       String                    @map("workspace_id")
  clientProfileId   String                    @map("client_profile_id")
  formId            String                    @map("form_id")
  weekday           CheckInWeekday
  // Minute-of-day 0–1439 in `timezone` (raw CHECK bounds it).
  localTimeMinutes  Int                       @map("local_time_minutes")
  // IANA zone, app-validated (Intl) at create — never a browser guess.
  timezone          String
  // Inclusive local-date bounds on generated occurrences.
  startDate         DateTime                  @map("start_date") @db.Date
  endDate           DateTime?                 @map("end_date") @db.Date
  status            CheckInScheduleRuleStatus @default(ACTIVE)
  createdByMemberId String                    @map("created_by_member_id")
  // Latest-pause provenance (pause is reversible; not a paired CHECK —
  // a resumed rule keeps the record of its last pause).
  pausedAt          DateTime?                 @map("paused_at") @db.Timestamptz(6)
  pausedByMemberId  String?                   @map("paused_by_member_id")
  // Paired end provenance — both null or both non-null (raw CHECK);
  // ENDED is terminal.
  endedAt           DateTime?                 @map("ended_at") @db.Timestamptz(6)
  endedByMemberId   String?                   @map("ended_by_member_id")
  // The rule that replaced this one (end-and-replace writes it once;
  // unique — a rule has at most one replacement).
  replacedByRuleId  String?                   @unique @map("replaced_by_rule_id")
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace       Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  clientProfile   ClientProfile        @relation("CheckInScheduleRuleClient", fields: [clientProfileId], references: [id], onDelete: Restrict)
  form            CheckInForm          @relation("CheckInScheduleRuleForm", fields: [formId], references: [id], onDelete: Restrict)
  createdByMember WorkspaceMember      @relation("CheckInScheduleRuleCreator", fields: [createdByMemberId], references: [id], onDelete: Restrict)
  pausedByMember  WorkspaceMember?     @relation("CheckInScheduleRulePauser", fields: [pausedByMemberId], references: [id], onDelete: Restrict)
  endedByMember   WorkspaceMember?     @relation("CheckInScheduleRuleEnder", fields: [endedByMemberId], references: [id], onDelete: Restrict)
  replacedByRule  CheckInScheduleRule? @relation("CheckInScheduleRuleReplacement", fields: [replacedByRuleId], references: [id], onDelete: Restrict)
  replacesRule    CheckInScheduleRule? @relation("CheckInScheduleRuleReplacement")
  instances       CheckInInstance[]

  // Composite coherence target for the instance's raw origin FK
  // (origin_rule_id, workspace_id, client_profile_id).
  @@unique([id, workspaceId, clientProfileId], map: "checkin_schedule_rule_coherence_key")
  @@index([workspaceId, clientProfileId, status])
  @@map("checkin_schedule_rule")
}

model ClientDashboardLayout {
  id                String   @id @default(cuid())
  workspaceId       String   @map("workspace_id")
  clientProfileId   String   @map("client_profile_id")
  // Configuration only — widgets, per-breakpoint rects and bounded
  // settings. No measurements, answers, fixture records or health
  // values are ever stored here.
  config            Json
  configVersion     Int      @default(1) @map("config_version")
  // Optimistic CAS — every autosave carries expectedRevision.
  revision          Int      @default(1)
  updatedByMemberId String?  @map("updated_by_member_id")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  clientProfile   ClientProfile    @relation("ClientDashboardLayoutClient", fields: [clientProfileId], references: [id], onDelete: Restrict)
  updatedByMember WorkspaceMember? @relation("DashboardLayoutEditor", fields: [updatedByMemberId], references: [id], onDelete: Restrict)

  // One arrangement per (workspace, client); (id, workspaceId) is the
  // composite target for same-workspace coherence FKs (raw SQL).
  @@unique([workspaceId, clientProfileId])
  @@unique([id, workspaceId])
  @@index([clientProfileId])
  @@map("client_dashboard_layout")
}

// CLIENT-TASKS-I1 (decision #109): staff-assigned client tasks — bounded
// coach-authored title + declared due date + lifecycle/provenance. The
// wide coherence key backs the composite same-workspace FK (raw SQL).
model ClientTask {
  id                  String           @id @default(cuid())
  workspaceId         String           @map("workspace_id")
  clientProfileId     String           @map("client_profile_id")
  // Coach-authored free text; trimmed non-empty <= 120 (raw CHECK).
  title               String
  // Declared calendar date (@db.Date) — never an instant; overdue is
  // computed against the server-UTC calendar date at read time.
  dueDate             DateTime         @map("due_date") @db.Date
  status              ClientTaskStatus @default(OPEN)
  // CAS for every transition/edit/cancel.
  revision            Int              @default(1)
  assignedByMemberId  String           @map("assigned_by_member_id")
  assignedAt          DateTime         @default(now()) @map("assigned_at") @db.Timestamptz(6)
  // completedByUserId is a best-effort pointer (SetNull, mirrors
  // ConsentRecord.grantedBy); completedAt is the durable CHECK bound.
  completedByUserId   String?          @map("completed_by_user_id")
  completedAt         DateTime?        @map("completed_at") @db.Timestamptz(6)
  cancelledByMemberId String?          @map("cancelled_by_member_id")
  cancelledAt         DateTime?        @map("cancelled_at") @db.Timestamptz(6)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace         Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  clientProfile     ClientProfile    @relation("ClientTaskClient", fields: [clientProfileId], references: [id], onDelete: Restrict)
  assignedByMember  WorkspaceMember  @relation("ClientTaskAssigner", fields: [assignedByMemberId], references: [id], onDelete: Restrict)
  completedBy       User?            @relation("ClientTaskCompleter", fields: [completedByUserId], references: [id], onDelete: SetNull)
  cancelledByMember WorkspaceMember? @relation("ClientTaskCanceller", fields: [cancelledByMemberId], references: [id], onDelete: Restrict)

  // Composite same-workspace coherence target (raw SQL FKs).
  @@unique([id, workspaceId])
  @@index([workspaceId, clientProfileId, dueDate])
  @@index([workspaceId, clientProfileId, status])
  @@map("client_task")
}

// HABITS-I1 (decision #110): staff-configured client habits — bounded
// name/target coaching metadata, CAS revision, archive timestamp. Many
// habits per client (no pair-unique — P3-R1 P1). The (id, workspace_id)
// unique is the generic same-workspace identity target (repo
// convention); the composite coherence FK on
// (client_profile_id, workspace_id) is added by raw SQL in the
// migration — not a Prisma composite relation.
model Habit {
  id              String    @id @default(cuid())
  workspaceId     String    @map("workspace_id")
  clientProfileId String    @map("client_profile_id")
  // Staff-authored coaching metadata; trimmed non-empty <= 120 (raw CHECK).
  name            String    @db.VarChar(120)
  target          String    @db.VarChar(120)
  // PR-M0: coach-visible reason text (canvas habit card).
  reason          String    @default("")
  // CAS for every edit/archive.
  revision        Int       @default(1)
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  clientProfile ClientProfile   @relation("HabitClient", fields: [clientProfileId], references: [id], onDelete: Restrict)
  schedules     HabitSchedule[]
  logs          HabitLog[]

  // Generic same-workspace identity target (repo convention) — retained
  // for composite coherence targets; no composite child FK currently
  // consumes it.
  @@unique([id, workspaceId])
  @@index([workspaceId, clientProfileId])
  @@map("habits")
}

// Effective-dated schedule boundaries. `effectiveFrom` is server-computed
// only; rows at past boundaries are never mutated. `weekdays` is an ISO
// bitmask (Mon=bit0 … Sun=bit6); 0 is written exclusively by the archive
// path (raw CHECK permits 0..127).
model HabitSchedule {
  id            String    @id @default(cuid())
  habitId       String    @map("habit_id")
  effectiveFrom DateTime  @map("effective_from") @db.Date
  weekdays      Int       @db.SmallInt
  endDate       DateTime? @map("end_date") @db.Date
  habit         Habit     @relation(fields: [habitId], references: [id], onDelete: Restrict)

  // One boundary per habit per day — same-day edits upsert at tomorrow.
  @@unique([habitId, effectiveFrom])
  @@map("habit_schedules")
}

// One log state per habit per day; clear = delete (Undo removes the row).
// `loggedByUserId` is best-effort provenance (SetNull, mirrors the
// ConsentRecord.grantedBy / ClientTask.completedBy precedent).
model HabitLog {
  id             String         @id @default(cuid())
  habitId        String         @map("habit_id")
  date           DateTime       @db.Date
  status         HabitLogStatus
  loggedByUserId String?        @map("logged_by_user_id")
  loggedAt       DateTime       @default(now()) @map("logged_at") @db.Timestamptz(6)
  habit          Habit          @relation(fields: [habitId], references: [id], onDelete: Restrict)
  loggedBy       User?          @relation("HabitLogLogger", fields: [loggedByUserId], references: [id], onDelete: SetNull)

  @@unique([habitId, date])
  @@map("habit_logs")
}

// ── MEAL-PLAN-I1 (decision #115 — PROMPT 211, synthetic-only) ────────────
// Versioned per-client meal plan: assigned coaches AND explicitly assigned
// owners author a shared draft (draftRevision CAS); publish mints an
// immutable version stamped with a stored (effectiveDate, effectiveTimezone,
// activationInstant) snapshot — client-local day start resolved ONCE at
// publish via lib/checkin/timezone.ts and never recomputed. All-entered
// nutrition values; nothing computed. The wide composite coherence FK on
// (meal_plan_id, workspace_id, client_profile_id) and the timezone
// provenance pairing CHECK are raw migration SQL (the established
// convention — Prisma cannot express them). No archive/delete/withdrawal/
// expiry semantics exist — none approved.
model MealPlan {
  id                    String    @id @default(cuid())
  workspaceId           String    @map("workspace_id")
  clientProfileId       String    @unique @map("client_profile_id")
  title                 String
  // Plan-scoped confirmed IANA timezone — NOT a global client setting.
  // Provenance pairing (all-null or all-set) is a raw migration CHECK.
  timezone              String?
  timezoneSetByMemberId String?   @map("timezone_set_by_member_id")
  timezoneSetAt         DateTime? @map("timezone_set_at") @db.Timestamptz(6)
  // Mutable shared draft; optimistic concurrency via draftRevision.
  // Publish snapshots it — the draft stays open (continuous editing).
  draft                 Json?
  draftRevision         Int       @default(1) @map("draft_revision")
  draftSavedByMemberId  String?   @map("draft_saved_by_member_id")
  draftUpdatedAt        DateTime? @map("draft_updated_at") @db.Timestamptz(6)
  createdByMemberId     String    @map("created_by_member_id")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace           Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  clientProfile       ClientProfile     @relation("MealPlanClient", fields: [clientProfileId], references: [id], onDelete: Restrict)
  createdByMember     WorkspaceMember   @relation("MealPlanCreator", fields: [createdByMemberId], references: [id], onDelete: Restrict)
  draftSavedByMember  WorkspaceMember?  @relation("MealPlanDraftSaver", fields: [draftSavedByMemberId], references: [id], onDelete: Restrict)
  timezoneSetByMember WorkspaceMember?  @relation("MealPlanTimezoneSetter", fields: [timezoneSetByMemberId], references: [id], onDelete: Restrict)
  versions            MealPlanVersion[]

  // Composite coherence targets for raw version FKs.
  @@unique([id, workspaceId])
  @@unique([id, workspaceId, clientProfileId])
  @@index([workspaceId])
  @@map("meal_plan")
}

model MealPlanVersion {
  id                    String   @id @default(cuid())
  // Denormalized tenant + client stamps — immutable at publish; part of
  // the (id, workspaceId, mealPlanId) coherence target.
  workspaceId           String   @map("workspace_id")
  mealPlanId            String   @map("meal_plan_id")
  clientProfileId       String   @map("client_profile_id")
  versionSeq            Int      @map("version_seq")
  // Declared calendar date + the IANA zone + resolved local-midnight
  // instant — all immutable snapshots taken at publish.
  effectiveDate         DateTime @map("effective_date") @db.Date
  effectiveTimezone     String   @map("effective_timezone")
  activationInstant     DateTime @map("activation_instant") @db.Timestamptz(6)
  payload               Json
  publishOriginRevision Int      @map("publish_origin_revision")
  publishedAt           DateTime @default(now()) @map("published_at") @db.Timestamptz(6)
  publishedByMemberId   String   @map("published_by_member_id")

  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  mealPlan          MealPlan        @relation(fields: [mealPlanId], references: [id], onDelete: Restrict)
  clientProfile     ClientProfile   @relation("MealPlanVersionClient", fields: [clientProfileId], references: [id], onDelete: Restrict)
  publishedByMember WorkspaceMember @relation("MealPlanVersionPublisher", fields: [publishedByMemberId], references: [id], onDelete: Restrict)

  @@unique([mealPlanId, versionSeq])
  // Deterministic publish-replay authority: one version per origin draft
  // revision (declared unique — matches the raw migration index name).
  @@unique([mealPlanId, publishOriginRevision], map: "meal_plan_version_publish_origin_key")
  @@unique([id, workspaceId, mealPlanId])
  @@index([mealPlanId, effectiveDate, versionSeq])
  @@index([mealPlanId, activationInstant])
  @@map("meal_plan_version")
}

// ── TRAINING-I1A (synthetic-only — PROMPT 244, reviewed P9+A1+A2+A3
// contract with S/G corrections) ────────────────────────────────────────
// Week-based per-client training program chain: assigned staff author a
// shared override-boundary draft under `draftRevision` CAS; first publish
// atomically claims a root slot or the live-successor slot of a published
// predecessor (single_root / live_successor partial uniques — raw SQL).
// Published activation instants are immutable; program weeks are anchored
// to the seq-1 version's effectiveTimezone forever; the mutable
// confirmedTimezone resolves only NEW publication instants. Pending
// (not-yet-in-force) leaf cancellation is the only cancellation. No
// archive/delete semantics exist — none approved.
model TrainingProgram {
  id                    String    @id @default(cuid())
  workspaceId           String    @map("workspace_id")
  clientProfileId       String    @map("client_profile_id")
  title                 String
  // Declared program start (YYYY-MM-DD in the client calendar). Locked
  // once firstPublishedAt is set — a different start = replacement.
  startDate             DateTime  @map("start_date") @db.Date
  weekCount             Int       @map("week_count")
  // WEEK_BASED | EVERGREEN. Locked at first publish — a different mode is
  // a replacement program, never an in-place conversion. Evergreen uses
  // weekCount=1 as its single prescription week (internal representation).
  programMode           String    @default("WEEK_BASED") @map("program_mode")
  // Program-level interim field authority (owner-approved): subset of the
  // eight prescription fields. Snapshotted into each version at publish.
  fieldConfig           Json      @map("field_config")
  // Program-scoped confirmed IANA timezone — mutable; affects only new
  // publication instants, never published snapshots or the week anchor.
  confirmedTimezone     String?   @map("confirmed_timezone")
  timezoneSetByMemberId String?   @map("timezone_set_by_member_id")
  timezoneSetAt         DateTime? @map("timezone_set_at") @db.Timestamptz(6)
  // Mutable shared draft: override-boundary sets (sparse week→value
  // boundaries per addressable node); optimistic CAS via draftRevision.
  draft                 Json?
  draftRevision         Int       @default(1) @map("draft_revision")
  draftSavedByMemberId  String?   @map("draft_saved_by_member_id")
  draftUpdatedAt        DateTime? @map("draft_updated_at") @db.Timestamptz(6)
  // Committed atomically at first publish (null while draft/pending save).
  replacesProgramId     String?   @map("replaces_program_id")
  // DB clock_timestamp() read after locks — lock-ordered per client.
  firstPublishedAt      DateTime? @map("first_published_at") @db.Timestamptz(6)
  // Pending-leaf cancellation only (pre-takeover); immutable once set.
  cancelledAt           DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledByMemberId   String?   @map("cancelled_by_member_id")
  // Defensive floor only (P9 §3.4): whollyPast under the immutable anchor
  // is already monotone; retained for schema stability, never load-bearing.
  lockedWeekHighWater   Int       @default(0) @map("locked_week_high_water")
  createdByMemberId     String    @map("created_by_member_id")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace           Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  clientProfile       ClientProfile            @relation("TrainingProgramClient", fields: [clientProfileId], references: [id], onDelete: Restrict)
  createdByMember     WorkspaceMember          @relation("TrainingProgramCreator", fields: [createdByMemberId], references: [id], onDelete: Restrict)
  draftSavedByMember  WorkspaceMember?         @relation("TrainingProgramDraftSaver", fields: [draftSavedByMemberId], references: [id], onDelete: Restrict)
  timezoneSetByMember WorkspaceMember?         @relation("TrainingProgramTimezoneSetter", fields: [timezoneSetByMemberId], references: [id], onDelete: Restrict)
  cancelledByMember   WorkspaceMember?         @relation("TrainingProgramCanceller", fields: [cancelledByMemberId], references: [id], onDelete: Restrict)
  versions            TrainingProgramVersion[]
  bookings            TrainingSessionBooking[]
  sessionLogs         TrainingSessionLog[]

  // Composite coherence targets for raw version/replacement FKs.
  @@unique([id, workspaceId])
  @@unique([id, workspaceId, clientProfileId])
  @@index([workspaceId])
  @@index([replacesProgramId])
  @@map("training_program")
}

model TrainingProgramVersion {
  id                    String   @id @default(cuid())
  // Denormalized tenant + client stamps — immutable at publish; part of
  // the (id, workspaceId, programId) coherence target.
  workspaceId           String   @map("workspace_id")
  programId             String   @map("program_id")
  clientProfileId       String   @map("client_profile_id")
  versionSeq            Int      @map("version_seq")
  // Declared calendar date + the IANA zone + resolved local-midnight
  // instant — all immutable snapshots taken at publish.
  effectiveDate         DateTime @map("effective_date") @db.Date
  effectiveTimezone     String   @map("effective_timezone")
  activationInstant     DateTime @map("activation_instant") @db.Timestamptz(6)
  // Materialized weeks 1..weekCount — self-contained, no provenance.
  payload               Json
  // Snapshot of the program's fieldConfig at publish.
  fieldConfig           Json     @map("field_config")
  // Deterministic publish-replay authority — NOT NULL, unique per program.
  publishOriginRevision Int      @map("publish_origin_revision")
  publishedAt           DateTime @default(now()) @map("published_at") @db.Timestamptz(6)
  publishedByMemberId   String   @map("published_by_member_id")

  workspace         Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  program           TrainingProgram          @relation(fields: [programId], references: [id], onDelete: Restrict)
  clientProfile     ClientProfile            @relation("TrainingProgramVersionClient", fields: [clientProfileId], references: [id], onDelete: Restrict)
  publishedByMember WorkspaceMember          @relation("TrainingProgramVersionPublisher", fields: [publishedByMemberId], references: [id], onDelete: Restrict)
  bookings          TrainingSessionBooking[]
  sessionLogs       TrainingSessionLog[]

  @@unique([programId, versionSeq])
  @@unique([programId, publishOriginRevision], map: "training_program_version_publish_origin_key")
  @@unique([id, workspaceId, programId])
  @@index([programId, activationInstant])
  @@map("training_program_version")
}

model TrainingSessionBooking {
  id                  String    @id @default(cuid())
  // Denormalized tenant/client stamps — part of the composite coherence
  // targets (raw-SQL FKs, established convention).
  workspaceId         String    @map("workspace_id")
  clientProfileId     String    @map("client_profile_id")
  programId           String    @map("program_id")
  // Immutable prescription pin: version + session + booked week, all
  // resolved ONCE at create. A move changes scheduledDate only.
  pinnedVersionId     String    @map("pinned_version_id")
  sessionId           String    @map("session_id")
  bookedWeek          Int       @map("booked_week")
  // Declared local calendar date in the program's immutable anchor
  // timezone — a date, never an instant.
  scheduledDate       DateTime  @map("scheduled_date") @db.Date
  scheduledByMemberId String    @map("scheduled_by_member_id")
  cancelledAt         DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledByMemberId String?   @map("cancelled_by_member_id")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace         Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  clientProfile     ClientProfile          @relation("TrainingBookingClient", fields: [clientProfileId], references: [id], onDelete: Restrict)
  program           TrainingProgram        @relation(fields: [programId], references: [id], onDelete: Restrict)
  pinnedVersion     TrainingProgramVersion @relation(fields: [pinnedVersionId], references: [id], onDelete: Restrict)
  scheduledByMember WorkspaceMember        @relation("TrainingBookingScheduler", fields: [scheduledByMemberId], references: [id], onDelete: Restrict)
  cancelledByMember WorkspaceMember?       @relation("TrainingBookingCanceller", fields: [cancelledByMemberId], references: [id], onDelete: Restrict)

  @@index([programId, scheduledDate])
  @@index([workspaceId, clientProfileId, scheduledDate], map: "training_session_booking_client_scope_date_idx")
  @@map("training_session_booking")
}

// ── PR-M10 (#176): the client's performed session log. One row per session
// occurrence (natural key on program + session + booked week + performed
// date), pinning the prescription version that governed at start — later
// publishes never rewrite the pinned payload beside the logged actuals.
// The set payload stores whatever fields the coach's own template defines
// (P01/O5): actuals travel as a validated JSONB SetLogEntry, never one
// column per field. Terminal states are explicit rows, not zeros.
model TrainingSessionLog {
  id                  String    @id @default(cuid())
  // Denormalized tenant/client stamps — part of the composite coherence
  // targets (raw-SQL FKs, established convention).
  workspaceId         String    @map("workspace_id")
  clientProfileId     String    @map("client_profile_id")
  programId           String    @map("program_id")
  // Immutable prescription pin: the version governing the performed date
  // at start. A later publish leaves this row beside the old payload.
  pinnedVersionId     String    @map("pinned_version_id")
  sessionId           String    @map("session_id")
  bookedWeek          Int       @map("booked_week")
  // Declared local calendar date the session was performed (anchor zone).
  performedDate       DateTime  @map("performed_date") @db.Date
  // IN_PROGRESS | COMPLETED | PARTIAL | SKIPPED (raw CHECK).
  status              String    @default("IN_PROGRESS")
  startedAt           DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  // Terminal instant for every non-IN_PROGRESS state (raw pairing CHECK).
  completedAt         DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  workspace     Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  clientProfile ClientProfile          @relation("TrainingSessionLogClient", fields: [clientProfileId], references: [id], onDelete: Restrict)
  program       TrainingProgram        @relation(fields: [programId], references: [id], onDelete: Restrict)
  pinnedVersion TrainingProgramVersion @relation(fields: [pinnedVersionId], references: [id], onDelete: Restrict)
  sets          TrainingSetLog[]

  // One log per session occurrence — the resume/replay natural key.
  @@unique([workspaceId, clientProfileId, programId, sessionId, bookedWeek, performedDate], map: "training_session_log_natural_key")
  // Composite coherence target for the raw set-log FK.
  @@unique([id, workspaceId, clientProfileId])
  @@index([workspaceId, clientProfileId, performedDate], map: "training_session_log_client_date_idx")
  @@map("training_session_log")
}

model TrainingSetLog {
  id              String   @id @default(cuid())
  sessionLogId    String   @map("session_log_id")
  // Denormalized tenant/client stamps — the raw composite FK pins every
  // set to the same (session, workspace, client) triple.
  workspaceId     String   @map("workspace_id")
  clientProfileId String   @map("client_profile_id")
  exerciseId      String   @map("exercise_id")
  // "p:{prescribedSetId}" or "a:{client-added set id}" — the idempotency
  // key; saving the same set twice updates this row instead of doubling.
  setKey          String   @map("set_key")
  position        Int
  // Validated SetLogEntry actuals — template-defined fields (P01).
  actuals         Json
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessionLog    TrainingSessionLog @relation(fields: [sessionLogId], references: [id], onDelete: Restrict)
  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  clientProfile ClientProfile      @relation("TrainingSetLogClient", fields: [clientProfileId], references: [id], onDelete: Restrict)

  @@unique([sessionLogId, exerciseId, setKey], map: "training_set_log_set_key")
  @@index([workspaceId, clientProfileId], map: "training_set_log_client_idx")
  @@map("training_set_log")
}

// ── PR-M0 schema v2 (D20, D24, D26, D27, D28, D31, O13) ──────────────────
// Workspace/product-wide settings, coach tools, messaging, media and plan
// aggregates. Composite same-workspace coherence FKs, restore-window
// pairing CHECKs, kind↔column CHECKs and content CHECKs are raw migration
