# Development preview: enable every product surface behind its dev flag.
# Loaded automatically by `next dev` after .env and .env.local; flags count
# only in a trusted development/test runtime (lib/runtime.ts devFlagEnabled),
# so production builds are unaffected. No secrets belong in this file.
#
# Deliberately unset:
#   ENABLE_DAILY_PROTOTYPE  conflicts with ENABLE_DAILY_ENTRY (conflict mode)
#   ENABLE_CONSENT_GATES    parked product decision, stays off everywhere
ENABLE_CHECK_INS=1
ENABLE_CLIENT_DASHBOARD=1
ENABLE_CLIENT_SETUP=1
ENABLE_CLIENT_SETUP_TRANSITIONS=1
ENABLE_COACHING_TEMPLATES=1
ENABLE_DAILY_ENTRY=1
ENABLE_IIFYM_PLANS=1
ENABLE_MEAL_PLANS=1
ENABLE_ONBOARDING_ASSIGNMENTS=1
ENABLE_ONBOARDING_SUBMISSION=1
ENABLE_PARAMETER_CLASSIFICATION=1
ENABLE_SUPPLEMENTS=1
ENABLE_TRAINING_PLANS=1
