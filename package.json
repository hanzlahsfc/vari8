{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "schema": "db/schema.prisma"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "index": "tsx scripts/index/generate.ts",
    "index:check": "tsx scripts/index/generate.ts --check",
    "extract:sheets": "tsx scripts/extract-sheets.ts",
    "import:nutrition": "tsx scripts/import-nutrition.ts",
    "import:exercise": "tsx scripts/import-exercise.ts",
    "seed:dev": "tsx scripts/seed/index.ts",
    "db:fresh": "tsx scripts/db-fresh.ts",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "parity": "node tools/parity/run.mjs",
    "check:nutrition-sources": "tsx scripts/check-nutrition-source-accuracy.ts --input bls=tests/fixtures/nutrition/bls-4.0-sample.xlsx --expected bls=tests/fixtures/nutrition/expected-bls.json --input ciqual=tests/fixtures/nutrition/ciqual-2025-sample.xlsx --expected ciqual=tests/fixtures/nutrition/expected-ciqual.json --manifest tests/fixtures/nutrition/MANIFEST.json"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@prisma/client": "^6.19.3",
    "better-auth": "^1.7.10",
    "cheerio": "^1.2.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "lucide-react": "1.52.0",
    "motion": "14.0.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "read-excel-file": "5.8.8",
    "tw-animate-css": "1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "jsdom": "30.1.1",
    "postcss": "8.5.29",
    "prettier": "^3.9.6",
    "prisma": "^6.19.3",
    "shadcn": "4.21.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
