# App — local development environment template.
# Copy to `.env` (gitignored) and adjust. Never commit real secrets.

# --- Docker PostgreSQL (see docker-compose.yml) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app_dev_password
POSTGRES_DB=app_dev

# --- Prisma ---
# Matches docker-compose local defaults (host port 5433). Change for any real environment.
DATABASE_URL=postgresql://app:app_dev_password@127.0.0.1:5433/app_dev?schema=public

# --- Better Auth (PR-05; replaces Auth.js) ---
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-32-byte-base64-secret
# Base URL the app is served from (session cookies, reset-link origins).
BETTER_AUTH_URL=http://127.0.0.1:3000

# --- Mail delivery (PR-05 password reset) ---
# Explicit adapter name enables outbound mail. In development, omitting it
# defaults to the dev-file adapter (appends to DEV_MAILBOX_FILE); in
# production an explicit adapter is REQUIRED or mail-gated routes fail closed.
# MAIL_DELIVERY_ADAPTER=dev-file
# DEV_MAILBOX_FILE=var/mailbox.jsonl

# --- Phase B0 Daily Tracker prototype (development-only) ---
# The read-only prototype at /daily is enabled ONLY when this is set to "1".
# Leave unset in any real deployment: the route returns 404, so a health-entry form is
# never exposed under the undecided access policy. Reach it directly at /daily.
# ENABLE_DAILY_PROTOTYPE=1

# --- Raw sheet viewer (development-only) ---
# /sheets and /sheets/[slug] are read-only developer/reference tools, not product
# pages. They are enabled ONLY when this is set to "1"; otherwise they return 404.
# ENABLE_SHEET_VIEWER=1

# --- P-013 onboarding assignments (development-only) ---
# Staff-only onboarding-form assignment surface at
# /workspace/[workspaceId]/onboarding/assignments. Enabled ONLY when this is
# exactly "1"; unset or any other value returns 404, hides the nav entry, and
# closes every server action before any input is read. Not enabled by default.
# ENABLE_ONBOARDING_ASSIGNMENTS=1

# --- Phase 7 (extraction) ---
# Read-only source folder for the upcoming sheet extractor. Defaults to the
# supplied exports folder; override to relocate it. Never write into it.
# SHEETS_SOURCE_DIR=/Users/apple/Downloads/PRGRSS 2.0 extracted/Copy of PRGRSS 2.0/

# P-014: development gate for the workspace parameter library + coaching
# templates (/workspace/[workspaceId]/parameters, /templates). Enabled ONLY
# when exactly "1"; any other value returns 404, hides the nav entries, and
# closes every server action before any input is read. Off by default.
# ENABLE_COACHING_TEMPLATES=1

# P-016: development gate for the staff-only client setup / template
# assignment surface at /workspace/[workspaceId]/client-setups. Enabled ONLY
# when exactly "1"; any other value returns 404, hides the nav entry, and
# closes every server action before any input is read. Off by default.
# ENABLE_CLIENT_SETUP=1

# P-020A: development gate for the parameter classification management
# control inside the parameter library (requires ENABLE_COACHING_TEMPLATES).
# Enabled ONLY when exactly "1"; any other value hides the control and closes
# the classify server action before any input is read. Off by default.
# NOTE: the nullable data_classification column, published-version snapshot
# field, universal duplicate-parameter publish rejection (#64), and the
# shared pure DailyEntry eligibility module are live on merge — NOT gated.
# ENABLE_PARAMETER_CLASSIFICATION=1

# P-020B (decisions #58–#62): development gate for template-version
# upgrade/rollback review + execution on client setups — layered INSIDE
# ENABLE_CLIENT_SETUP (both must be exactly "1"). Enabled ONLY when exactly
# "1"; any other value hides the control and closes every transition server
# action before session, input, provider, or database work. Off by default.
# ENABLE_CLIENT_SETUP_TRANSITIONS=1

# P-021 (decisions #64–#78): development gate for client-authored DailyEntry
# persistence on /workspace/[workspaceId]/daily — snapshot-driven form +
# read-only history for the authorized client only. Enabled ONLY when
# exactly "1"; unset/off/invalid keeps the structural shell, hides
# persistence affordances, and closes the save server action before session,
# FormData, provider, or database work. When BOTH this flag and
# ENABLE_DAILY_PROTOTYPE are "1" the resolver is "conflict": the shell stays
# up and persistence is unavailable (fail-safe). Off by default.
# PRODUCTION: the consent policy registry is unconfigured and fails closed —
# with this flag unset production CANNOT collect any daily-entry values.
# ENABLE_DAILY_ENTRY=1

# P-023 (decisions #82–#85): development gate for the client onboarding
# submission flow on /workspace/[workspaceId]/onboarding — own-assignment
# discovery, single-session fill, irreversible submit, and the read-only
# submitted view for the authorized client only. Enabled ONLY when exactly
# "1"; unset/off/invalid 404s the routes and closes the submit server
# action before session, FormData, or database work. Off by default.
# PRODUCTION: the flag alone NEVER configures consent — the synthetic
# consent registry resolves only in a trusted development/test runtime
# (APP_ENV=development|test, or NODE_ENV=development|test). Production,
# unknown, or missing classifications stay unconfigured and fail closed,
# so this flag set in production still CANNOT collect onboarding answers.
# ENABLE_ONBOARDING_SUBMISSION=1
#
# APP_ENV — optional explicit runtime classification for the dev/test-only
# consent boundary above. `next start` always runs NODE_ENV=production, so
# disposable test servers set APP_ENV=test to activate the synthetic
# registry. Any other value (or absent) is production-safe.
# APP_ENV=test

# P-025-A (decisions #92–#97): development gate for the staff Check-In
# form-definition surfaces under /workspace/[workspaceId]/checkins/forms —
# library, create, draft editor, read-only preview, publish, and archive.
# Enabled ONLY when exactly "1" AND the shared resolver classifies the
# runtime as trusted development/test (APP_ENV=development|test, or
# NODE_ENV=development|test when APP_ENV is unset). Production, unknown, or
# missing classifications fail closed even with this flag set — the flag
# alone NEVER enables production. Off by default; no Check-In instances,
# scheduling, client submission, answers, or reviews exist in this slice.
# ENABLE_CHECK_INS=1
